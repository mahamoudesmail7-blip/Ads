# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign auth JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Meta Ads — real OAuth "Connect Meta Ads Account" integration
# (backend/src/routes/meta.js, services/metaAuth.js|metaGraphClient.js|
# metaSync.js). App ID/Secret are from the Meta App Dashboard > Settings >
# Basic. META_CONFIG_ID is the Facebook Login for Business configuration ID
# ("Meta Ads Connection") already set up. META_REDIRECT_URI must be pasted
# EXACTLY into that same Facebook Login for Business product's "Valid OAuth
# Redirect URIs" in the Meta App Dashboard, or the OAuth flow will be
# rejected by Facebook. META_TOKEN_ENCRYPTION_KEY encrypts the OAuth access
# token at rest (AES-256-GCM) — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID="2166183033951878"
META_REDIRECT_URI="http://localhost:4000/api/meta/callback"
META_TOKEN_ENCRYPTION_KEY=""

# Superseded by the real OAuth flow above (this was scaffolding for a
# simpler static-token setup that was never built) — unused by any code
# now, left only in case a manual-override path is ever needed later.
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID="1688438875190730"

# EasyOrders — API key from Seller Dashboard > Public API (used only as a
# fallback to backfill an order our webhook missed). Webhook secret is
# generated when you create the webhook in that same dashboard, pointing at
# <your-public-url>/api/webhooks/easyorders — paste it here once you have it.
EASYORDERS_API_KEY=""
EASYORDERS_WEBHOOK_SECRET=""

# Anthropic (Claude) API key — AI Business Intelligence module. Phase 1
# (ads upload / column mapping / True Business Performance) is fully
# deterministic and does NOT require this; it's wired up now for later
# phases (AI Business Chat, narrative Decision Center). Never sent to the
# frontend — read only in backend/src/services/ai.js.
ANTHROPIC_API_KEY=""

# Where the frontend is served from — used for CORS + cookie SameSite rules.
FRONTEND_URL="http://localhost:8080"
BACKEND_URL="http://localhost:4000"

PORT=4000
NODE_ENV="development"
