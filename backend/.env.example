# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign auth JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Meta Ads — real OAuth "Connect Meta Ads Account" integration
# (backend/src/routes/meta.js, services/metaAuth.js|metaGraphClient.js|
# metaSync.js). App ID/Secret are from the Meta App Dashboard > Settings >
# Basic. META_CONFIG_ID is the Facebook Login for Business configuration ID
# ("Meta Ads Connection") already set up. META_REDIRECT_URI must be pasted
# EXACTLY into that same Facebook Login for Business product's "Valid OAuth
# Redirect URIs" in the Meta App Dashboard, or the OAuth flow will be
# rejected by Facebook. META_TOKEN_ENCRYPTION_KEY encrypts the OAuth access
# token at rest (AES-256-GCM) — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID="2166183033951878"
META_REDIRECT_URI="http://localhost:4000/api/meta/callback"
META_TOKEN_ENCRYPTION_KEY=""

# Superseded by the real OAuth flow above (this was scaffolding for a
# simpler static-token setup that was never built) — unused by any code
# now, left only in case a manual-override path is ever needed later.
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID="1688438875190730"

# EasyOrders — API key from Seller Dashboard > Public API (used only as a
# fallback to backfill an order our webhook missed).
#
# EasyOrders issues a SEPARATE secret per webhook TYPE even though both post
# to the same URL (/api/webhooks/easyorders) — register BOTH webhooks
# ("Order Created" and "Order Status Update") in the seller dashboard and
# paste each one's own secret here. A request is classified by its payload
# shape first, then checked against the matching secret below — the two are
# never interchangeable.
EASYORDERS_API_KEY=""
EASYORDERS_WEBHOOK_SECRET=""        # the "Order Created" webhook's secret
EASYORDERS_STATUS_WEBHOOK_SECRET="" # the "Order Status Update" webhook's secret

# ============================================================================
# AI GATEWAY (backend/src/services/aiGateway) — OpenAI is the single, only
# active AI provider for every text/reasoning/vision feature in the system:
# the AI Command Center chat (routes/aiAssistant.js), the AI Action Plan on
# AI Intelligence, Product Research's product analysis/ranking/content
# analysis, AI Media Buyer's recommendation narration, AI Creative Factory's
# text/vision layer, and the AI Product Marketing Center. Image generation/
# editing already used OPENAI_API_KEY below (unchanged). Reuses the SAME key
# — no second OpenAI credential needed. Get one at
# platform.openai.com/api-keys (requires billing).
#
# AI_TEXT_ROUTINE_MODEL / AI_TEXT_BALANCED_MODEL / AI_TEXT_ADVANCED_MODEL:
# the three cost-tiered models every feature routes through (never hardcoded
# in code) — routine = high-volume simple work (hooks, posts, short
# diagnosis, classification); balanced = real multi-factor reasoning
# (audience/angle discovery, creative strategy, vision understanding);
# advanced = full strategic analysis only, explicitly triggered. Set these
# to whatever model ids your OpenAI project actually has access to — the
# admin "استهلاك OpenAI" health check verifies they're real before relying
# on them, it never assumes.
AI_TEXT_ROUTINE_MODEL="gpt-5.6-luna"
AI_TEXT_BALANCED_MODEL="gpt-5.6-terra"
AI_TEXT_ADVANCED_MODEL="gpt-5.6-sol"
# AI_IMAGE_MODEL is now the ONE authoritative image-model variable — real
# generation (services/creativeFactory/imageProvider.js) AND the admin
# health check/dashboard both resolve through this exact same precedence:
# AI_IMAGE_MODEL -> CF_IMAGE_MODEL (legacy override, still honoured) ->
# "gpt-image-1". Before pointing this at "gpt-image-2", confirm it's really
# available to this OpenAI project via the "اختبار الاتصال" button on
# ai-usage.html (a free model-list check, never a paid generation) — do not
# assume access from documentation.
AI_IMAGE_MODEL=""
# ANTHROPIC_ENABLED must stay "false" (or unset) in normal operation — the
# legacy services/ai.js Anthropic client refuses to run otherwise, even if
# some forgotten import still points at it (rollback safety net, §47).
ANTHROPIC_ENABLED="false"
# Never auto-fallback to another provider on an OpenAI failure — a clear
# error instead, always.
AI_FALLBACK_PROVIDER="none"
#
# Monthly budget guard (optional — unset = no ceiling, no warning). At
# OPENAI_WARNING_PERCENT the admin usage screen shows a warning; at 100% (and
# OPENAI_HARD_LIMIT_ENABLED=true) new AI generation is blocked with a clear
# message — deterministic calculations, cached results, and every non-AI
# feature keep working regardless.
OPENAI_MONTHLY_BUDGET_USD=""
OPENAI_WARNING_PERCENT="80"
OPENAI_HARD_LIMIT_ENABLED="true"
#
# Per-tier $/1M-token pricing (optional — leave unset and the admin usage
# screen honestly shows "unknown cost" for that tier rather than a guessed
# number; fill in from platform.openai.com/pricing once you know the real
# current rates for your configured models).
AI_PRICE_ROUTINE_INPUT_PER_1M=""
AI_PRICE_ROUTINE_OUTPUT_PER_1M=""
AI_PRICE_BALANCED_INPUT_PER_1M=""
AI_PRICE_BALANCED_OUTPUT_PER_1M=""
AI_PRICE_ADVANCED_INPUT_PER_1M=""
AI_PRICE_ADVANCED_OUTPUT_PER_1M=""

# Anthropic (Claude) — LEGACY, kept only for rollback (services/ai.js is
# gated by ANTHROPIC_ENABLED above and refuses to run unless it's "true").
# Not used by any active feature post-migration.
ANTHROPIC_API_KEY=""
ANTHROPIC_WORKSPACE_ID=""

# Product Research Intelligence (routes/productResearch.js) — multi-platform
# product/competitor discovery. Optional: the feature runs and shows an
# honest "Not Configured" Provider Status without these, never fake results.
#
# SERPAPI_API_KEY: preferred provider for Instagram/Facebook/TikTok
# discovery (site:-filtered real Google results via serpapi.com — no
# dedicated per-platform engine exists there either, same honest approach
# as GOOGLE_SEARCH_API_KEY below). Get a key at serpapi.com/manage-api-key.
SERPAPI_API_KEY=""
# GOOGLE_SEARCH_API_KEY + GOOGLE_SEARCH_ENGINE_ID: fallback for Instagram/
# Facebook/TikTok when SERPAPI_API_KEY isn't set (via site:-filtered Google
# Custom Search — no official third-party public-content search API exists
# for those platforms) and is YouTube's fallback when YOUTUBE_API_KEY isn't
# set. Get a key at console.cloud.google.com (enable "Custom Search API");
# create a search engine at programmablesearchengine.google.com (set it to
# search the whole web) and copy its Search Engine ID.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
# YOUTUBE_API_KEY: real YouTube Data API v3 key (same Google Cloud project,
# enable "YouTube Data API v3") — preferred over Google Custom Search for
# YouTube specifically since it returns real view/like counts.
YOUTUBE_API_KEY=""
# Search-pipeline limits (Step 21 cost control) — sensible defaults if unset.
MAX_QUERIES_PER_SEARCH=24
MAX_RESULTS_PER_PLATFORM=100
MAX_AI_RANKING_RESULTS=60
SEARCH_CACHE_TTL=3600

# Meta Ads Library (services/searchProviders/metaAdLibraryProvider.js) —
# NO new variable needed. It reuses two things you've already configured:
#   1. The existing "Connect Meta Ads Account" OAuth connection (META_APP_ID/
#      META_APP_SECRET above) — its stored token already has ads_read, which
#      is what the real Meta Ad Library API (/ads_archive) needs. Connect it
#      the same way as for Meta Ads sync (ai-intelligence.html).
#   2. SERPAPI_API_KEY above — used as the honest fallback for countries/ad
#      categories the official Ad Library API doesn't expose unrestricted
#      commercial-ad search for (Egypt included — this is Meta's own real
#      API limitation, not a bug here).
#
# PRIMARY provider (tried before both of the above) — Apify
# (services/searchProviders/apifyMetaAdLibraryProvider.js), manually
# verified working for Egypt/Active/keyword search. Get a token at
# console.apify.com/settings/integrations.
APIFY_API_TOKEN=""
# Optional override if the actor you actually tested differs from the
# verified default (curious_coder/facebook-ads-library-scraper). Only set
# this if you used a different one — never guess a value here.
APIFY_META_AD_LIBRARY_ACTOR_ID=""
# Cost protection (Apify bills ~$0.75/1,000 ads) — hard ceiling on raw ads
# collected per search across all discovery stages, regardless of what
# raw-limit the user picks in the UI (100/250/500/1000/2000).
APIFY_AD_LIBRARY_MAX_RAW_RESULTS_PER_SEARCH=500

# AI Creative Factory (routes/creativeFactory.js, services/creativeFactory/*)
# — AI product-image creation. The whole workflow (product, reference images,
# Product DNA, creative plan, quality thresholds, projects) runs WITHOUT any
# of these; only actual image generation needs OPENAI_API_KEY. It never
# fabricates an image when the key is missing.
#
# OPENAI_API_KEY: OpenAI key for the Images API (gpt-image-1). Read only in
# services/creativeFactory/imageProvider.js, never sent to the frontend.
# Get one at platform.openai.com/api-keys (requires billing).
OPENAI_API_KEY=""
# Optional overrides (sensible defaults if unset):
# CF_IMAGE_PROVIDER: "openai" (default when OPENAI_API_KEY is set) | "disabled"
# CF_IMAGE_MODEL: default "gpt-image-1"
# CF_IMAGE_QUALITY: low | medium | high (default "medium" — ~$0.04/image on
#   gpt-image-1 vs ~$0.17 for "high"; "medium" is fine for ad creatives).
# CF_STORAGE_PROVIDER: "db" (default — durable Postgres, no bucket needed) |
#   s3 | cloudinary | supabase (adapters are config-ready placeholders that
#   fail loudly until their own env vars + integration are added).
# CF_QUALITY_THRESHOLD (default 88), CF_PRODUCT_ACCURACY_THRESHOLD (default 90),
# CF_REALISM_THRESHOLD (default 72 — "would a customer suspect AI?"),
# CF_GOOD_ENOUGH_MARGIN (default 8 — accept product-correct + realistic images
#   a few points under the bar instead of chasing 96),
# CF_GENERATION_CONCURRENCY (default 3 — independent images generated in
#   parallel), CF_MAX_RETRIES_FAST (default 1), CF_MAX_RETRIES_PREMIUM
#   (default 2) — retries are always TARGETED, never a blind repeat,
# CF_MAX_IMAGES_PER_PROJECT (default 50), CF_PREMIUM_CANDIDATES (default 2 —
#   best-of-N for the HERO image only, PREMIUM mode only),
# CF_TEXT_OVERLAY (default true — Arabic is rendered by our own engine with
#   the Cairo font, never by the image model; set false to let the model
#   draw the text),
# CF_DEFAULT_GENERATION_MODE (FAST|PREMIUM),
# CF_MIN_REFERENCE_IMAGES (default 3), CF_MAX_REFERENCE_IMAGES (default 6),
# CF_IMAGE_UNIT_COST_USD (per-image $ estimate; shown as "غير متاحة حاليًا"
#   when unset — no invented pricing),
# CF_DAILY_IMAGE_BUDGET / CF_MONTHLY_IMAGE_BUDGET (USD; 0 = no ceiling).
CF_IMAGE_PROVIDER=""
CF_IMAGE_MODEL=""
CF_STORAGE_PROVIDER=""
CF_IMAGE_UNIT_COST_USD=""
CF_GENERATION_CONCURRENCY="3"

# Where the frontend is served from — used for CORS + cookie SameSite rules.
FRONTEND_URL="http://localhost:8080"
BACKEND_URL="http://localhost:4000"

PORT=4000
NODE_ENV="development"
