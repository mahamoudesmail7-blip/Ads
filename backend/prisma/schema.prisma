// Prisma schema — mirrors js/db.js's 15 IndexedDB stores field-for-field
// (same field names, same shapes) plus one new `User` table for auth, so the
// REST API can return objects the existing frontend already knows how to
// render without any renaming on the client side.

generator client {
  provider = "prisma-client-js"
}

// Role is a plain String (not a DB enum) on purpose — it works unchanged on
// both SQLite and Postgres, validated at the application layer instead
// (zod, in routes/auth.js). The 3 fields stored as String that hold JSON
// text (Settings.data, DailyReport.summary, InventoryImportBatch.unmatched)
// are the same story: works identically on both providers, so left as-is
// rather than switched to Postgres's native Json type.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// status: PENDING (new signup, awaiting Owner approval) | ACTIVE | REJECTED | DISABLED.
// permissions: JSON-encoded object of granular flags (e.g. {"products.create":true})
// — same "JSON stored as String" convention as Settings.data/DailyReport.summary
// elsewhere in this schema. Defaults to "{}" (no permissions) on purpose: a newly
// approved user gets nothing until the Owner explicitly grants it.
// is_owner: protects the one founding account — never settable via any API,
// checked everywhere a role/status/permission change targets a user.
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String
  role          String   @default("EMPLOYEE")
  status        String   @default("PENDING")
  date_of_birth String?
  permissions   String   @default("{}")
  is_owner      Boolean  @default(false)
  created_at    DateTime @default(now())

  assigned_tasks TaskRecord[] @relation("TaskAssignee")
  created_tasks  TaskRecord[] @relation("TaskCreator")
  activity_log   TaskActivityLog[]
  lost_order_notes   LostOrderNote[]
  lost_order_actions LostOrderHistory[]
  ads_uploads        AdsUpload[]
  ads_decision_reviews AdsDecisionReview[]
  meta_connections     MetaConnection[]
  ai_audit_log_entries AiAuditLog[]
  product_research_searches     ProductResearchSearch[]
  product_research_competitors  ProductResearchCompetitor[]
  experimental_creative_searches ExperimentalCreativeSearch[] // Internal Creative Discovery experimental section — fully separate tables from ProductResearch*, see model below

  @@map("users")
}

model Product {
  id                    Int      @id @default(autoincrement())
  product_name          String
  sku                   String?
  product_code          String?  @unique
  category              String?
  selling_price         Float    @default(0)
  product_cost          Float    @default(0)
  active                Boolean  @default(true)
  is_demo               Boolean  @default(false)
  shipping_cost         Float?
  packaging_cost        Float?
  other_cost            Float?
  advertising_cost      Float?
  expected_return_cost  Float?
  commission            Float?
  current_stock         Float?
  minimum_stock         Float?
  supplier              String?
  restock_quantity      Float?
  last_restock_date     String?
  created_at            DateTime @default(now())

  orders             DailyOrder[]
  notes              ProductNote[]
  action_logs        ActionLog[]
  task_records       TaskRecord[]
  inventory_snapshots InventorySnapshot[]
  inventory_movement InventoryMovementLog[]
  easyorders_orders  EasyOrdersOrder[]
  ads_metrics        AdsDailyMetric[]
  product_research_searches    ProductResearchSearch[]
  product_research_competitors ProductResearchCompetitor[]

  @@index([active])
  @@index([product_name])
  @@index([sku])
  @@map("products")
}

model DailyOrder {
  id              Int      @id @default(autoincrement())
  product_id      Int
  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  date            String
  orders_count    Int
  delivered_count Int?
  returned_count  Int?
  notes           String?
  is_demo         Boolean  @default(false)
  source          String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@map("daily_orders")
}

// One row per (EasyOrders order, cart item) — NOT the same shape as
// DailyOrder (which only holds an aggregate count). This table is what lets
// a later "order-status-update" webhook (which carries only an order_id, no
// product info) find and correct the right DailyOrder row: look up every
// EasyOrdersOrder row for that order_id, update their status, then
// recompute the DailyOrder aggregate for each (product_id, date) touched.
// @@unique on (order_id, cart_item_id) makes the webhook handler safe to
// re-run on a retried/duplicate delivery — same design goal as
// DailyOrder's own (product_id, date) uniqueness.
model EasyOrdersOrder {
  id            Int      @id @default(autoincrement())
  order_id      String
  short_id      Int? // EasyOrders' human-friendly order number (e.g. #2167) — the real reference number a customer/employee would actually recognize, not the internal UUID
  cart_item_id  String
  product_id    Int?
  product       Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  sku           String?
  product_name_raw String? // EasyOrders' own product name, kept even when matched==false so the UI always has a real name to show — never a fabricated placeholder for an unmatched order.
  date          String
  status        String // normalized: PENDING | CONFIRMED | DELIVERED | RETURNED | CANCELLED
  raw_status    String?
  quantity      Int      @default(1)
  matched       Boolean  @default(true)
  // Customer/order-level fields — the webhook payload always includes these
  // (order.full_name/phone/government/address/cost/shipping_cost) but nothing
  // read them until the Lost Orders feature needed to show a real customer
  // contact for a replacement order. Redundantly stored per cart-item row
  // (same values across every row of one order_id) rather than restructuring
  // the table — simplest fix for a real gap, not a new integration.
  customer_name    String?
  customer_phone   String?
  customer_address String?
  customer_government String?
  order_cost       Float?
  shipping_cost    Float?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([order_id, cart_item_id])
  @@index([date])
  @@index([product_id])
  @@index([order_id])
  @@map("easyorders_orders")
}

// Internal-only processing state for a real EasyOrders order whose status
// landed on RETURNED (raw_status "returning_from_delivery" — EasyOrders has
// no native "lost" status; this is our own business classification layered
// on top of their real data, per explicit user direction). One row per
// EasyOrders order_id, created automatically the moment that status is
// first observed (webhook or reconciliation) — see services/lostOrders.js.
model LostOrder {
  id                    Int      @id @default(autoincrement())
  order_id              String   @unique
  processing_status     String   @default("NEW") // NEW | PROCESSING | CONTACTED | CUSTOMER_APPROVED | CUSTOMER_REJECTED | REPLACEMENT_CREATED | CLOSED
  replacement_order_id  String? // set once a real replacement order exists in EasyOrders (feature currently blocked — see conversation)
  source                String   @default("AUTO") // AUTO (real status == returning_from_delivery) | MANUAL (a human flagged it — e.g. EasyOrders' own "تحت المراجعة" dashboard flag, which their public API never exposes)
  manual_reason         String? // required when source == MANUAL — why a human is flagging an order the API itself shows no problem with
  // Human correction layer — EasyOrders has no API to push an edited
  // address/phone back to them, so this is a LOCAL override only: the
  // original EasyOrdersOrder customer fields stay untouched (real record of
  // what EasyOrders actually sent), and these take precedence for display
  // and for prefilling the replacement-order form when set.
  override_customer_name       String?
  override_customer_phone      String?
  override_customer_address    String?
  override_customer_government String?
  detected_at           DateTime @default(now())
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  notes   LostOrderNote[]
  history LostOrderHistory[]

  @@map("lost_orders")
}

model LostOrderNote {
  id            Int       @id @default(autoincrement())
  lost_order_id Int
  lostOrder     LostOrder @relation(fields: [lost_order_id], references: [id], onDelete: Cascade)
  text          String
  author_id     Int?
  author        User?     @relation(fields: [author_id], references: [id], onDelete: SetNull)
  created_at    DateTime  @default(now())

  @@index([lost_order_id])
  @@map("lost_order_notes")
}

// Every real action taken on a lost order — who, what, when. Never
// backfilled with invented past events; only written at the moment an
// action actually happens.
model LostOrderHistory {
  id            Int       @id @default(autoincrement())
  lost_order_id Int
  lostOrder     LostOrder @relation(fields: [lost_order_id], references: [id], onDelete: Cascade)
  action        String // DETECTED | STATUS_CHANGED | NOTE_ADDED | CUSTOMER_EDITED
  detail        String?
  actor_id      Int?
  actor         User?     @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  created_at    DateTime  @default(now())

  @@index([lost_order_id])
  @@map("lost_order_history")
}

model Settings {
  id    String @id @default("default")
  data  String

  @@map("settings")
}

model ProductNote {
  id         Int      @id @default(autoincrement())
  product_id Int
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  text       String
  created_at DateTime @default(now())

  @@index([product_id])
  @@map("product_notes")
}

model ActionLog {
  id                   Int      @id @default(autoincrement())
  product_id           Int
  product              Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  date                 String
  status               String
  task_type            String?
  priority             String?
  action_label         String?
  reason_text          String?
  not_completed_reason String?
  not_completed_note   String?
  completed_at         DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@map("action_log")
}

model DailyReport {
  id           Int      @id @default(autoincrement())
  date         String
  type         String
  summary      String
  report_text  String
  generated_at DateTime @default(now())

  @@unique([date, type])
  @@index([date])
  @@map("daily_reports")
}

model TeamMember {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  active             Boolean  @default(true)
  daily_task_target  Int      @default(10)
  created_at         DateTime @default(now())

  assignments TaskAssignment[]

  @@map("team_members")
}

model TaskAssignment {
  id          Int        @id @default(autoincrement())
  product_id  Int
  date        String
  employee_id Int
  employee    TeamMember @relation(fields: [employee_id], references: [id])
  assigned_at DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@index([employee_id])
  @@map("task_assignments")
}

// Field names here match js/task-store.js's actual read/write shape exactly
// (product_name, details, source, assignment_source, assigned_by,
// manager_note, related_campaign, today/yesterday/diff snapshot, cancelled_by
// / cancel_reason, not_completed_reason / not_completed_note) — that module
// is unchanged by this migration, so the API must speak its existing shape.
// created_by_id/employee accountability (real User FKs) are NEW fields added
// on top, satisfying "record who assigned/completed/cancelled it" without
// breaking any existing field task-store.js/manager.js already reads.
model TaskRecord {
  id                   Int       @id @default(autoincrement())
  date                 String
  product_id           Int?
  product              Product?  @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name         String?
  employee_id          Int?
  employee             User?     @relation("TaskAssignee", fields: [employee_id], references: [id], onDelete: SetNull)
  created_by_id        Int?
  created_by           User?     @relation("TaskCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  status               String    @default("PENDING")
  task_type            String?
  priority             String?
  title                String?
  details              String?
  manager_note         String?
  related_campaign     String?
  source               String?
  assignment_source    String?
  assigned_by          String?
  assigned_at          DateTime?
  today                Float?
  yesterday            Float?
  diff                 Float?
  due_date             String?
  execution_date       String?
  completed_at         DateTime?
  not_completed_reason String?
  not_completed_note   String?
  cancelled_at         DateTime?
  cancelled_by         String?
  cancel_reason        String?
  // AI Intelligence -> Manager Control bridge (additive, all nullable —
  // every existing task simply has these as null forever). source_entity_*
  // mirrors AdsDecisionReview's (entity_type, entity_key) idiom: the AI
  // recommendation is a live-computed entity, never its own DB row, so the
  // link is a synthetic key, not a real FK. ai_recommendation_snapshot is a
  // JSON-as-String capture of the recommendation's numbers/reason/action at
  // the moment the task was created (historical "before" record — the
  // entity's live numbers can move on). review_status/employee_result are
  // the manager-approval layer on top of the unchanged `status` field: a
  // task an employee submits a result for still becomes status=COMPLETED
  // exactly as before, but also gets review_status='PENDING_REVIEW' until a
  // manager approves it — existing tasks/flows never set this, so they are
  // untouched by its existence.
  source_entity_type        String?
  source_entity_key         String?
  ai_recommendation_snapshot String?
  review_status              String?
  employee_result             String?
  manager_review_note         String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  activity TaskActivityLog[]

  @@index([date])
  @@index([employee_id])
  @@index([product_id])
  @@index([status])
  @@index([source_entity_type, source_entity_key])
  @@map("task_records")
}

model TaskActivityLog {
  id            Int         @id @default(autoincrement())
  date          String
  task_id       Int?
  task          TaskRecord? @relation(fields: [task_id], references: [id], onDelete: SetNull)
  action_type   String?
  employee_to   Int?
  employee_from Int?
  details_text  String?
  actor_id      Int?
  actor         User?       @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  created_at    DateTime    @default(now())

  @@index([date])
  @@index([task_id])
  @@map("task_activity_log")
}

model InventorySnapshot {
  id             Int      @id @default(autoincrement())
  product_id     Int
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_name   String
  date           String
  opening_stock  Float?
  closing_stock  Float
  units_out      Float    @default(0)
  stock_change   Float?
  movement_type  String
  source         String?
  batch_id       Int?
  notes          String?
  updated_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@map("inventory_snapshots")
}

model InventoryMovementLog {
  id            Int      @id @default(autoincrement())
  product_id    Int
  product       Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_name  String
  date          String
  previous_qty  Float?
  new_qty       Float?
  diff          Float?
  movement_type String
  notes         String?
  updated_by    String?
  batch_id      Int?
  created_at    DateTime @default(now())

  @@index([date])
  @@index([product_id])
  @@map("inventory_movement_log")
}

model InventoryColumnMapping {
  id           String   @id @default("default")
  productName  String?
  quantity     String?
  sku          String?
  warehouse    String?
  updated_at   DateTime @updatedAt

  @@map("inventory_column_mapping")
}

model InventoryNameMapping {
  id                 Int      @id @default(autoincrement())
  excel_name_key     String   @unique
  excel_name_original String
  product_id         Int
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("inventory_name_mapping")
}

model InventoryImportBatch {
  id              Int      @id @default(autoincrement())
  date            String
  filename        String?
  uploaded_by     String?
  total_rows      Int?
  matched_count   Int?
  unmatched_count Int?
  duplicate_count Int?
  invalid_count   Int?
  unmatched       String?
  uploaded_at     DateTime @default(now())

  @@index([date])
  @@map("inventory_import_batches")
}

// ============================================================================
// AI Business Intelligence — Phase 1 (Ads Data Upload → Column Mapping →
// Normalized Storage → True Business Performance). See conversation for the
// full 43-section spec this is Phase 1 of; later phases (Decision Center,
// Creative/Audience/Governorate/Moderator Intelligence, Forecasting, AI
// Chat...) are explicitly deferred and add their own models when built.
// ============================================================================

// One row per uploaded Meta Ads Manager export. Raw data is kept verbatim in
// AdsRawRow regardless of what happens after — "احتفظ دائمًا بالـ Raw
// Uploaded Data بدون تعديل" (spec section 1, Step 3).
model AdsUpload {
  id             Int       @id @default(autoincrement())
  filename       String
  file_type      String // csv | xlsx
  status         String    @default("UPLOADED") // UPLOADED | MAPPED | PROCESSED | FAILED
  row_count      Int?
  uploaded_by_id Int?
  uploaded_by    User?     @relation(fields: [uploaded_by_id], references: [id], onDelete: SetNull)
  column_mapping String? // JSON-as-String — confirmed source-column -> canonical-field map (same convention as Settings.data)
  errors         String? // JSON-as-String — validation warnings/errors from Step 1, kept for audit even after processing
  uploaded_at    DateTime  @default(now())
  processed_at   DateTime?

  rawRows AdsRawRow[]
  metrics AdsDailyMetric[]

  @@map("ads_uploads")
}

model AdsRawRow {
  id         Int       @id @default(autoincrement())
  upload_id  Int
  upload     AdsUpload @relation(fields: [upload_id], references: [id], onDelete: Cascade)
  row_index  Int
  raw_data   String // JSON-as-String — the untouched original row exactly as uploaded
  created_at DateTime  @default(now())

  @@index([upload_id])
  @@map("ads_raw_rows")
}

// Normalized, mapped ads performance data — one row per (date, campaign/adset/ad)
// combination as present in the source file. matched_product_* is populated by
// a confidence-gated Campaign Name -> Product match (never a low-confidence
// auto-guess — see services/adsImport.js), the join key True Business
// Performance needs to compare Meta's numbers against real order data.
model AdsDailyMetric {
  id                 Int       @id @default(autoincrement())
  upload_id          Int
  upload             AdsUpload @relation(fields: [upload_id], references: [id], onDelete: Cascade)
  date               String
  campaign_id        String?
  campaign_name      String?
  adset_id           String?
  adset_name         String?
  ad_id              String?
  ad_name            String?
  creative_id        String?
  creative_name      String?
  spend              Float?
  impressions        Int?
  reach              Int?
  frequency          Float?
  clicks             Int?
  ctr                Float?
  cpc                Float?
  cpm                Float?
  landing_page_views Int?
  leads              Int?
  add_to_cart        Int?
  initiate_checkout  Int?
  meta_purchases     Int?
  meta_revenue       Float?
  meta_roas          Float?
  // Meta's own objective-agnostic outcome metric — always present in a
  // standard export regardless of what the campaign optimizes for, unlike
  // meta_purchases (only meaningful for purchase-objective campaigns).
  // result_indicator carries what "Results" actually counted for that row
  // (e.g. "actions:offsite_conversion.fb_pixel_purchase") so it's never a
  // black box. campaign_delivery ("active"/"paused") lets analysis exclude
  // paused campaigns from "why is this still spending" alerts.
  results            Int?
  cost_per_result    Float?
  result_indicator   String?
  campaign_delivery  String?
  matched_product_id Int?
  matched_product    Product?  @relation(fields: [matched_product_id], references: [id], onDelete: SetNull)
  match_confidence   Float?
  match_method       String? // exact_name | exact_sku | fuzzy | unmatched
  created_at         DateTime  @default(now())

  @@index([date])
  @@index([campaign_name])
  @@index([matched_product_id])
  @@map("ads_daily_metrics")
}

// User "Mark as Reviewed" / "Dismiss" on a decision-engine recommendation
// (AI Intelligence Phase 2, spec §21) — the app only ever records that a
// human looked at a recommendation; it never touches Meta budgets/campaigns
// itself. entity_key is a product id (as a string) or a campaign name,
// matching decisionEngine.js's entityKey.
model AdsDecisionReview {
  id            Int       @id @default(autoincrement())
  entity_type   String // product | campaign
  entity_key    String
  status        String // REVIEWED | DISMISSED
  reviewed_by_id Int?
  reviewed_by   User?     @relation(fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at   DateTime  @default(now())

  @@unique([entity_type, entity_key])
  @@map("ads_decision_reviews")
}

// Cached AI Action Plan (AI Intelligence Phase 2, spec §9) — the Claude
// Marketing Performance Decision Agent is given the already-computed,
// classified, prioritized entity list from decisionEngine.js (never raw
// CSV rows) and asked only to write the natural-language reason/action text
// plus a short cross-category summary. input_hash lets a page load reuse
// the cached plan instead of calling the API again when nothing changed;
// the "🔄 تحديث الخطة" button forces a fresh call.
model AdsActionPlan {
  id          Int      @id @default(autoincrement())
  window_from String
  window_to   String
  input_hash  String
  plan_json   String // JSON-as-String — {summary, items: [{entityType, entityKey, reason, recommendedAction}, ...]}
  source      String   @default("AI") // AI | FALLBACK — FALLBACK means the Claude call failed and deterministic templates were used instead
  generated_at DateTime @default(now())

  @@unique([window_from, window_to])
  @@map("ads_action_plans")
}

// Real Meta Ads OAuth connection (Facebook Login for Business) — a
// single-tenant singleton, same idiom as `Settings` (id:"default"). The
// access token is NEVER stored in plaintext (see services/metaCrypto.js)
// and is never sent to the frontend by any route — only `status` and the
// selected-account metadata are. Historical AdsDailyMetric rows synced
// while connected are never deleted on disconnect.
model MetaConnection {
  id                        String    @id @default("default")
  status                    String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED
  connected_by_id           Int?
  connected_by              User?     @relation(fields: [connected_by_id], references: [id], onDelete: SetNull)
  access_token_enc          String? // AES-256-GCM ciphertext, base64 — see metaCrypto.js
  token_expires_at          DateTime?
  meta_user_id              String?
  meta_user_name            String?
  selected_business_id      String?
  selected_business_name    String?
  selected_ad_account_id    String?
  selected_ad_account_name  String?
  last_synced_at            DateTime?
  connected_at              DateTime?
  disconnected_at           DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  @@map("meta_connections")
}

// AI E-Commerce Operating System — every real tool call the AI agent makes
// (backend/src/services/aiTools.js) is logged here, and every assistant
// turn (backend/src/routes/aiAssistant.js) is logged as its own entry with
// tool_calls listing the JSON-encoded tool names/results actually used to
// answer it. This is the real Audit Log the spec requires — never a UI
// mockup. Phase 1 ships read-only tools only (action="READ"); write-tool
// entries (action="EXECUTE") are additive groundwork for later phases and
// unused until those tools exist.
model AiAuditLog {
  id           Int      @id @default(autoincrement())
  actor_id     Int? // the logged-in user who triggered this (chat message or quick action) — null for a system-triggered call, none exist yet
  actor        User?    @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  kind         String // "TOOL_CALL" | "ASSISTANT_TURN"
  action       String // "READ" | "EXECUTE" — every Phase 1 tool is READ
  tool_name    String? // set for kind=TOOL_CALL
  input_json   String? // JSON-encoded tool input / user message
  output_json  String? // JSON-encoded tool result (never the raw LLM prose for TOOL_CALL rows)
  success      Boolean  @default(true)
  error        String?
  created_at   DateTime @default(now())

  @@index([created_at])
  @@index([kind])
  @@map("ai_audit_log")
}

// ============================================================================
// Product Research Intelligence — multi-platform product/competitor discovery.
// Pipeline: user input -> Claude product analysis -> query generation ->
// search providers (services/searchProviders/*) -> normalization -> Claude
// ranking -> dedup -> saved here. All additive, all new tables.
// ============================================================================

model ProductResearchSearch {
  id              Int       @id @default(autoincrement())
  user_id         Int
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product_id      Int? // optional link to an existing Product
  product         Product?  @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name    String
  product_image   String? // stored filename under uploads/product-research/, never the raw client filename
  country         String    @default("EG")
  language        String    @default("AR_EN")
  platforms_json  String // JSON array, e.g. ["instagram","tiktok","facebook","youtube"]
  results_per_platform Int  @default(25)
  status          String    @default("PENDING") // PENDING|ANALYZING|GENERATING_QUERIES|SEARCHING|RANKING|COMPLETED|PARTIAL|FAILED
  platform_status_json String? // {"instagram":"COMPLETE","tiktok":"FAILED",...} — per-platform status for partial-failure UI
  ai_profile_json String? // Claude's structured product profile (Step 2 schema)
  input_json      String? // the raw user-entered names/keywords, preserved verbatim — Claude output is merged onto this, never overwrites it
  error           String?
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  queries         ProductResearchQuery[]
  results         ProductResearchResult[]
  competitors     ProductResearchCompetitor[]
  insight         ProductResearchInsight?

  @@index([user_id])
  @@index([product_id])
  @@index([status])
  @@map("product_research_searches")
}

model ProductResearchQuery {
  id           Int      @id @default(autoincrement())
  search_id    Int
  search       ProductResearchSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform     String
  query        String
  query_type   String // EXACT_NAME|ALTERNATIVE_NAME|ARABIC_NAME|ENGLISH_NAME|FEATURE|BENEFIT|PROBLEM|GENERIC|VISUAL_DESCRIPTION
  provider     String // which SearchProvider actually ran this
  result_count Int      @default(0)
  status       String   @default("PENDING") // PENDING|RUNNING|COMPLETE|FAILED
  error        String?
  created_at   DateTime @default(now())

  @@index([search_id])
  @@map("product_research_queries")
}

model ProductResearchResult {
  id                Int       @id @default(autoincrement())
  search_id         Int
  search            ProductResearchSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform          String
  content_type      String    @default("Unknown") // Profile|Page|Post|Reel|Video|Short|Channel|Creator|Unknown
  canonical_url     String
  original_url      String
  title             String?
  snippet           String?
  account_name      String?
  account_url       String?
  thumbnail         String?
  published_at      DateTime?
  metrics_json      String? // {"views":123,"likes":45,...} — only keys actually returned by the provider, never fabricated
  provider          String
  classification    String? // EXACT_MATCH|VERY_SIMILAR|SIMILAR|RELATED|IRRELEVANT — null until AI ranking runs
  match_score       Int?
  confidence_score  Int?
  ai_reason         String?
  ignored           Boolean   @default(false)
  raw_metadata_json String? // the provider's raw response fields, kept for debugging/re-ranking, never shown raw in the UI
  discovered_by_queries_json String? // which query ids/text found this result
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  competitor        ProductResearchCompetitor?

  @@unique([search_id, canonical_url])
  @@index([search_id])
  @@index([platform])
  @@index([match_score])
  @@map("product_research_results")
}

model ProductResearchCompetitor {
  id             Int       @id @default(autoincrement())
  product_id     Int?
  product        Product?  @relation(fields: [product_id], references: [id], onDelete: SetNull)
  search_id      Int?
  search         ProductResearchSearch? @relation(fields: [search_id], references: [id], onDelete: SetNull)
  result_id      Int?      @unique
  result         ProductResearchResult? @relation(fields: [result_id], references: [id], onDelete: SetNull)
  platform       String
  account_name   String?
  account_url    String
  country        String?
  follower_count Int? // null (never fabricated) when the provider doesn't return it — UI shows "غير متاح"
  notes          String?
  saved_by_id    Int?
  saved_by       User?     @relation(fields: [saved_by_id], references: [id], onDelete: SetNull)
  first_seen     DateTime  @default(now())
  last_seen      DateTime  @default(now())
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([product_id])
  @@index([search_id])
  @@map("product_research_competitors")
}

// One row per completed search — the Market Insights section (Step 14).
// Kept separate from ProductResearchSearch so it can be regenerated
// independently without touching the search row itself.
model ProductResearchInsight {
  id            Int      @id @default(autoincrement())
  search_id     Int      @unique
  search        ProductResearchSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  insights_json String // {observedData:{...}, aiInterpretation:{...}} — kept explicitly separate per Step 14's requirement
  generated_at  DateTime @default(now())

  @@map("product_research_ai_insights")
}

// ============================================================
// Internal Creative Discovery — EXPERIMENTAL, fully separate tables.
// Deliberately NOT reusing ProductResearchSearch/Query/Result: the ask was
// explicit isolation ("must be isolated so I can test... safely", "do not
// change current database behavior unless strictly required") — a shared
// table would mean any experimental-path bug or query mistake could leak
// into the real Product Research history/results, which the isolation
// requirement was specifically meant to prevent. Shape mirrors
// ProductResearchSearch/Query/Result closely on purpose so the same
// normalize/dedup/query-generation/ranking service functions can be reused
// as-is (see experimentalCreativeDiscovery.js) without needing any change
// to those shared services.
// ============================================================

model ExperimentalCreativeSearch {
  id              Int       @id @default(autoincrement())
  user_id         Int
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_mode     String    @default("INTERNAL_EXPERIMENTAL") // the explicit marker requested — never confused with a real ProductResearchSearch row (they're not even in the same table)
  search_mode     String    @default("TEXT") // TEXT | IMAGE_ONLY — IMAGE_ONLY means product_name was empty at submit time and gets filled in from the generated Product Identity Profile once Stage A finishes
  product_name    String // for IMAGE_ONLY this starts as a placeholder and is overwritten once Stage A image analysis produces a real mainProductName — never left as the placeholder in a COMPLETED/PARTIAL row
  product_image   String? // kept as the FIRST reference image for backward compatibility with every existing read path — never removed
  product_images_json String? // JSON array of 1-4 real uploaded reference image data-URIs (Step: same-exact-product visual matching) — product_image always equals element [0] of this array when present
  country         String    @default("EG")
  language        String    @default("AR_EN")
  platforms_json  String
  mode            String    @default("quick") // quick|deep
  status          String    @default("PENDING") // PENDING|ANALYZING|GENERATING_QUERIES|SEARCHING|RANKING|COMPLETED|PARTIAL|FAILED|CANCELLED
  platform_status_json String?
  platform_progress_json String? // real per-platform 0-100 progress, JSON map {platform: number} — driven entirely by real execution stages in experimentalCreativeDiscovery.js (job created/provider initialized/queries prepared/per-query progress/results collected/normalized/saved/completed), never a frontend timer; persisted here so it survives a page refresh (Step: real Progress system)
  ai_profile_json String?
  identity_profile_json String? // the full Product Identity Profile generated from the image (Stage A + any Stage B enrichment) — see productVisionService.js
  identity_provider      String? // LOCAL_VISION | LOCAL_VISION+ANTHROPIC | ANTHROPIC_VISION — diagnostic: which real provider(s) actually produced this profile (Step 24)
  reference_image_hash  String? // sha256 of the uploaded image bytes — cache key alongside model_version
  input_json      String?
  error           String?
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  queries         ExperimentalCreativeQuery[]
  results         ExperimentalCreativeResult[]

  @@index([user_id])
  @@index([status])
  @@map("experimental_creative_searches")
}

model ExperimentalCreativeQuery {
  id           Int      @id @default(autoincrement())
  search_id    Int
  search       ExperimentalCreativeSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform     String
  query        String
  query_type   String
  provider     String // the REAL provider that actually ran this (e.g. serpapi, youtube_data_api, apify_meta_ad_library) — never a fabricated "internal" label; see the report on why
  result_count Int      @default(0)
  status       String   @default("PENDING")
  error        String?
  created_at   DateTime @default(now())

  @@index([search_id])
  @@map("experimental_creative_queries")
}

model ExperimentalCreativeResult {
  id                Int       @id @default(autoincrement())
  search_id         Int
  search            ExperimentalCreativeSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform          String
  content_type      String    @default("Unknown")
  canonical_url     String
  original_url      String
  title             String?
  snippet           String?
  account_name      String?
  account_url       String?
  thumbnail         String?
  published_at      DateTime?
  metrics_json      String?
  provider          String
  classification    String?
  match_score       Int?
  confidence_score  Int?
  ai_reason         String?
  visual_match_score Int? // 0-100, the FINAL visual score used for ranking — local embedding/perceptual-hash/OCR comparison, optionally blended with a real Claude-vision semantic score when Anthropic is healthy. Null when not computed (no reference image, no candidate thumbnail, candidate fetch failed, or beyond the per-search comparison cap) — never guessed.
  local_visual_match_score Int? // 0-100, the raw LOCAL_VISION-only score (embedding cosine similarity + perceptual hash + OCR brand/model match) — always populated whenever local comparison genuinely ran, independent of Anthropic (Step 10/11)
  visual_match_provider String? // LOCAL_EMBEDDING | LOCAL_EMBEDDING+ANTHROPIC — diagnostic (Step 24)
  final_score       Int?  // the weighted combination (80% visual / 15% text / 5% distinctive attributes) used for image-mode ranking when a reference image exists — null otherwise, text match_score is used as-is
  matched_reference_index Int? // which uploaded reference image (0-based, into product_images_json) produced the BEST visual match for this result — real multi-reference matching (Step: same-exact-product visual matching), null when no reference image or comparison never ran
  match_reasons     String? // JSON array of short, honest strings describing WHY this score was reached (e.g. "تشابه بصري عالي (embedding)", "تطابق لون مميز", "تطابق نص/موديل OCR") — never invented, only set when a real signal actually contributed
  exact_match_score Int? // 0-100 (Step: exact product matching) — deterministic weighted combination of visual embedding + structural (perceptual hash) + brand/model text + existing text match_score + color, computed only when a real visual comparison ran; never invented, category alone can never reach a high value here
  match_decision    String? // EXACT | REVIEW | REJECT | null (null = never evaluated, e.g. no reference image) — thresholds are configurable via Settings (icdExactMatchThreshold/icdReviewMatchThreshold), never hardcoded blindly
  ignored           Boolean   @default(false)
  raw_metadata_json String?
  discovered_by_queries_json String?
  ad_analysis_json   String?   // Step: Meta Ads competitor intelligence — structured per-ad analysis (hook/angle/price/offer/CTA/etc.), only ever populated for platform=META_AD_LIBRARY rows with match_decision=EXACT. Every field inside carries its own source: OBSERVED|AI_INFERRED|AI_ANALYZED tag — never presented as one undifferentiated fact.
  ad_analysis_status String?   // PENDING | DONE | FAILED | SKIPPED — null until competitor-analysis is attempted for this row
  ad_analyzed_at     DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@unique([search_id, canonical_url])
  @@index([search_id])
  @@index([platform])
  @@map("experimental_creative_results")
}

// Step: Meta Ads competitor intelligence — caches one ad's AI analysis by a
// STABLE ad identifier (metrics.adId when available, else a hash of
// canonical_url), never by search_id, so the exact same competitor ad
// surfacing again in a different search is never re-billed to Claude.
// Mirrors ExperimentalImageIdentityCache's exact (key, model_version)
// caching idiom used elsewhere in this file.
model ExperimentalAdAnalysisCache {
  id            Int      @id @default(autoincrement())
  ad_key        String   // sha256 of metrics.adId || canonical_url
  model_version String   // bumped whenever the analysis prompt/output shape changes, invalidating stale cached entries safely
  analysis_json String
  created_at    DateTime @default(now())

  @@unique([ad_key, model_version])
  @@map("experimental_ad_analysis_cache")
}

// Caches a generated Product Identity Profile by (reference image content
// hash, model version) so re-opening/re-running a search with the exact
// same uploaded image never re-spends a Claude vision call (Steps 26/27).
// Deliberately keyed on the image bytes' hash, not a search id, so it's
// shared across searches/users that happen to upload the identical file.
model ExperimentalImageIdentityCache {
  id            Int      @id @default(autoincrement())
  image_hash    String   // sha256 of the raw image bytes
  model_version String   // bumped whenever a provider's output shape changes, so an old cached profile is never served against a newer expected shape
  provider      String   @default("ANTHROPIC_VISION") // LOCAL_VISION | ANTHROPIC_VISION — the two providers cache independently under the same image_hash, since LOCAL_VISION is now always attempted and ANTHROPIC_VISION only sometimes
  profile_json  String   // LOCAL_VISION: {ocr, embedding, perceptualHash, colors, category, ...}. ANTHROPIC_VISION: the full Claude-generated Product Identity Profile (unchanged shape)
  created_at    DateTime @default(now())

  @@unique([image_hash, model_version, provider])
  @@map("experimental_image_identity_cache")
}
