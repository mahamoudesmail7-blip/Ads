// Prisma schema — mirrors js/db.js's 15 IndexedDB stores field-for-field
// (same field names, same shapes) plus one new `User` table for auth, so the
// REST API can return objects the existing frontend already knows how to
// render without any renaming on the client side.

generator client {
  provider = "prisma-client-js"
}

// Role is a plain String (not a DB enum) on purpose — it works unchanged on
// both SQLite and Postgres, validated at the application layer instead
// (zod, in routes/auth.js). The 3 fields stored as String that hold JSON
// text (Settings.data, DailyReport.summary, InventoryImportBatch.unmatched)
// are the same story: works identically on both providers, so left as-is
// rather than switched to Postgres's native Json type.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// status: PENDING (new signup, awaiting Owner approval) | ACTIVE | REJECTED | DISABLED.
// permissions: JSON-encoded object of granular flags (e.g. {"products.create":true})
// — same "JSON stored as String" convention as Settings.data/DailyReport.summary
// elsewhere in this schema. Defaults to "{}" (no permissions) on purpose: a newly
// approved user gets nothing until the Owner explicitly grants it.
// is_owner: protects the one founding account — never settable via any API,
// checked everywhere a role/status/permission change targets a user.
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  name          String
  role          String   @default("EMPLOYEE")
  status        String   @default("PENDING")
  date_of_birth String?
  permissions   String   @default("{}")
  is_owner      Boolean  @default(false)
  created_at    DateTime @default(now())

  assigned_tasks                 TaskRecord[]                 @relation("TaskAssignee")
  created_tasks                  TaskRecord[]                 @relation("TaskCreator")
  activity_log                   TaskActivityLog[]
  lost_order_notes               LostOrderNote[]
  lost_order_actions             LostOrderHistory[]
  ads_uploads                    AdsUpload[]
  ads_decision_reviews           AdsDecisionReview[]
  meta_connections               MetaConnection[]
  ai_audit_log_entries           AiAuditLog[]
  product_research_searches      ProductResearchSearch[]
  product_research_competitors   ProductResearchCompetitor[]
  experimental_creative_searches ExperimentalCreativeSearch[] // Internal Creative Discovery experimental section — fully separate tables from ProductResearch*, see model below
  // AI Media Buyer — additive back-relations only (no column change on `users`).
  amb_products_created           AmbProduct[]
  amb_maps_created               AmbProductCampaignMap[]
  amb_recommendations_reviewed   AmbRecommendation[]
  amb_actions_executed           AmbAction[]
  amb_clone_batches_created      AmbCloneBatch[]              @relation("AmbCloneCreator")
  amb_clone_batches_approved     AmbCloneBatch[]              @relation("AmbCloneApprover")
  amb_clone_audit_entries        AmbCloneAudit[]              @relation("AmbCloneAuditActor")
  media_scalings_created         MediaLibraryScaling[]        @relation("MediaScalingCreator")
  amb_scale_decisions_reviewed   AmbScaleDecision[]
  // AI Creative Factory — additive back-relations only (no column change on `users`).
  cf_products_created            CfProduct[]                  @relation("CfProductCreator")
  cf_projects_created            CfProject[]                  @relation("CfProjectCreator")
  cf_jobs_created                CfJob[]                      @relation("CfJobCreator")
  cf_variations_created          CfVariation[]                @relation("CfVariationCreator")
  cf_feedback_created            CfFeedback[]                 @relation("CfFeedbackCreator")

  @@map("users")
}

model Product {
  id                   Int      @id @default(autoincrement())
  product_name         String
  sku                  String?
  product_code         String?  @unique
  category             String?
  selling_price        Float    @default(0)
  product_cost         Float    @default(0)
  active               Boolean  @default(true)
  is_demo              Boolean  @default(false)
  shipping_cost        Float?
  packaging_cost       Float?
  other_cost           Float?
  advertising_cost     Float?
  expected_return_cost Float?
  commission           Float?
  current_stock        Float?
  minimum_stock        Float?
  supplier             String?
  restock_quantity     Float?
  last_restock_date    String?
  created_at           DateTime @default(now())

  orders                       DailyOrder[]
  notes                        ProductNote[]
  action_logs                  ActionLog[]
  task_records                 TaskRecord[]
  inventory_snapshots          InventorySnapshot[]
  inventory_movement           InventoryMovementLog[]
  easyorders_orders            EasyOrdersOrder[]
  ads_metrics                  AdsDailyMetric[]
  product_research_searches    ProductResearchSearch[]
  product_research_competitors ProductResearchCompetitor[]
  amb_product                  AmbProduct? // AI Media Buyer economics profile for this product (optional 1:1) — additive
  cf_product                   CfProduct? // AI Creative Factory profile for this product (optional 1:1) — additive

  @@index([active])
  @@index([product_name])
  @@index([sku])
  @@map("products")
}

model DailyOrder {
  id              Int      @id @default(autoincrement())
  product_id      Int
  product         Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  date            String
  orders_count    Int
  delivered_count Int?
  returned_count  Int?
  notes           String?
  is_demo         Boolean  @default(false)
  source          String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@map("daily_orders")
}

// One row per (EasyOrders order, cart item) — NOT the same shape as
// DailyOrder (which only holds an aggregate count). This table is what lets
// a later "order-status-update" webhook (which carries only an order_id, no
// product info) find and correct the right DailyOrder row: look up every
// EasyOrdersOrder row for that order_id, update their status, then
// recompute the DailyOrder aggregate for each (product_id, date) touched.
// @@unique on (order_id, cart_item_id) makes the webhook handler safe to
// re-run on a retried/duplicate delivery — same design goal as
// DailyOrder's own (product_id, date) uniqueness.
model EasyOrdersOrder {
  id                  Int      @id @default(autoincrement())
  order_id            String
  short_id            Int? // EasyOrders' human-friendly order number (e.g. #2167) — the real reference number a customer/employee would actually recognize, not the internal UUID
  cart_item_id        String
  product_id          Int?
  product             Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  sku                 String?
  product_name_raw    String? // EasyOrders' own product name, kept even when matched==false so the UI always has a real name to show — never a fabricated placeholder for an unmatched order.
  date                String
  status              String // normalized: PENDING | CONFIRMED | DELIVERED | RETURNED | CANCELLED
  raw_status          String?
  quantity            Int      @default(1)
  matched             Boolean  @default(true)
  // Customer/order-level fields — the webhook payload always includes these
  // (order.full_name/phone/government/address/cost/shipping_cost) but nothing
  // read them until the Lost Orders feature needed to show a real customer
  // contact for a replacement order. Redundantly stored per cart-item row
  // (same values across every row of one order_id) rather than restructuring
  // the table — simplest fix for a real gap, not a new integration.
  customer_name       String?
  customer_phone      String?
  customer_address    String?
  customer_government String?
  order_cost          Float?
  shipping_cost       Float?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([order_id, cart_item_id])
  @@index([date])
  @@index([product_id])
  @@index([order_id])
  @@map("easyorders_orders")
}

// Internal-only processing state for a real EasyOrders order whose status
// landed on RETURNED (raw_status "returning_from_delivery" — EasyOrders has
// no native "lost" status; this is our own business classification layered
// on top of their real data, per explicit user direction). One row per
// EasyOrders order_id, created automatically the moment that status is
// first observed (webhook or reconciliation) — see services/lostOrders.js.
model LostOrder {
  id                           Int      @id @default(autoincrement())
  order_id                     String   @unique
  processing_status            String   @default("NEW") // NEW | PROCESSING | CONTACTED | CUSTOMER_APPROVED | CUSTOMER_REJECTED | REPLACEMENT_CREATED | CLOSED
  replacement_order_id         String? // set once a real replacement order exists in EasyOrders (feature currently blocked — see conversation)
  source                       String   @default("AUTO") // AUTO (real status == returning_from_delivery) | MANUAL (a human flagged it — e.g. EasyOrders' own "تحت المراجعة" dashboard flag, which their public API never exposes)
  manual_reason                String? // required when source == MANUAL — why a human is flagging an order the API itself shows no problem with
  // Human correction layer — EasyOrders has no API to push an edited
  // address/phone back to them, so this is a LOCAL override only: the
  // original EasyOrdersOrder customer fields stay untouched (real record of
  // what EasyOrders actually sent), and these take precedence for display
  // and for prefilling the replacement-order form when set.
  override_customer_name       String?
  override_customer_phone      String?
  override_customer_address    String?
  override_customer_government String?
  detected_at                  DateTime @default(now())
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  notes   LostOrderNote[]
  history LostOrderHistory[]

  @@map("lost_orders")
}

model LostOrderNote {
  id            Int       @id @default(autoincrement())
  lost_order_id Int
  lostOrder     LostOrder @relation(fields: [lost_order_id], references: [id], onDelete: Cascade)
  text          String
  author_id     Int?
  author        User?     @relation(fields: [author_id], references: [id], onDelete: SetNull)
  created_at    DateTime  @default(now())

  @@index([lost_order_id])
  @@map("lost_order_notes")
}

// Every real action taken on a lost order — who, what, when. Never
// backfilled with invented past events; only written at the moment an
// action actually happens.
model LostOrderHistory {
  id            Int       @id @default(autoincrement())
  lost_order_id Int
  lostOrder     LostOrder @relation(fields: [lost_order_id], references: [id], onDelete: Cascade)
  action        String // DETECTED | STATUS_CHANGED | NOTE_ADDED | CUSTOMER_EDITED
  detail        String?
  actor_id      Int?
  actor         User?     @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  created_at    DateTime  @default(now())

  @@index([lost_order_id])
  @@map("lost_order_history")
}

model Settings {
  id   String @id @default("default")
  data String

  @@map("settings")
}

model ProductNote {
  id         Int      @id @default(autoincrement())
  product_id Int
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  text       String
  created_at DateTime @default(now())

  @@index([product_id])
  @@map("product_notes")
}

model ActionLog {
  id                   Int       @id @default(autoincrement())
  product_id           Int
  product              Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  date                 String
  status               String
  task_type            String?
  priority             String?
  action_label         String?
  reason_text          String?
  not_completed_reason String?
  not_completed_note   String?
  completed_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@map("action_log")
}

model DailyReport {
  id           Int      @id @default(autoincrement())
  date         String
  type         String
  summary      String
  report_text  String
  generated_at DateTime @default(now())

  @@unique([date, type])
  @@index([date])
  @@map("daily_reports")
}

model TeamMember {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  active            Boolean  @default(true)
  daily_task_target Int      @default(10)
  created_at        DateTime @default(now())

  assignments TaskAssignment[]

  @@map("team_members")
}

model TaskAssignment {
  id          Int        @id @default(autoincrement())
  product_id  Int
  date        String
  employee_id Int
  employee    TeamMember @relation(fields: [employee_id], references: [id])
  assigned_at DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@index([employee_id])
  @@map("task_assignments")
}

// Field names here match js/task-store.js's actual read/write shape exactly
// (product_name, details, source, assignment_source, assigned_by,
// manager_note, related_campaign, today/yesterday/diff snapshot, cancelled_by
// / cancel_reason, not_completed_reason / not_completed_note) — that module
// is unchanged by this migration, so the API must speak its existing shape.
// created_by_id/employee accountability (real User FKs) are NEW fields added
// on top, satisfying "record who assigned/completed/cancelled it" without
// breaking any existing field task-store.js/manager.js already reads.
model TaskRecord {
  id                         Int       @id @default(autoincrement())
  date                       String
  product_id                 Int?
  product                    Product?  @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name               String?
  employee_id                Int?
  employee                   User?     @relation("TaskAssignee", fields: [employee_id], references: [id], onDelete: SetNull)
  created_by_id              Int?
  created_by                 User?     @relation("TaskCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  status                     String    @default("PENDING")
  task_type                  String?
  priority                   String?
  title                      String?
  details                    String?
  manager_note               String?
  related_campaign           String?
  source                     String?
  assignment_source          String?
  assigned_by                String?
  assigned_at                DateTime?
  today                      Float?
  yesterday                  Float?
  diff                       Float?
  due_date                   String?
  execution_date             String?
  completed_at               DateTime?
  not_completed_reason       String?
  not_completed_note         String?
  cancelled_at               DateTime?
  cancelled_by               String?
  cancel_reason              String?
  // AI Intelligence -> Manager Control bridge (additive, all nullable —
  // every existing task simply has these as null forever). source_entity_*
  // mirrors AdsDecisionReview's (entity_type, entity_key) idiom: the AI
  // recommendation is a live-computed entity, never its own DB row, so the
  // link is a synthetic key, not a real FK. ai_recommendation_snapshot is a
  // JSON-as-String capture of the recommendation's numbers/reason/action at
  // the moment the task was created (historical "before" record — the
  // entity's live numbers can move on). review_status/employee_result are
  // the manager-approval layer on top of the unchanged `status` field: a
  // task an employee submits a result for still becomes status=COMPLETED
  // exactly as before, but also gets review_status='PENDING_REVIEW' until a
  // manager approves it — existing tasks/flows never set this, so they are
  // untouched by its existence.
  source_entity_type         String?
  source_entity_key          String?
  ai_recommendation_snapshot String?
  review_status              String?
  employee_result            String?
  manager_review_note        String?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  activity TaskActivityLog[]

  @@index([date])
  @@index([employee_id])
  @@index([product_id])
  @@index([status])
  @@index([source_entity_type, source_entity_key])
  @@map("task_records")
}

model TaskActivityLog {
  id            Int         @id @default(autoincrement())
  date          String
  task_id       Int?
  task          TaskRecord? @relation(fields: [task_id], references: [id], onDelete: SetNull)
  action_type   String?
  employee_to   Int?
  employee_from Int?
  details_text  String?
  actor_id      Int?
  actor         User?       @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  created_at    DateTime    @default(now())

  @@index([date])
  @@index([task_id])
  @@map("task_activity_log")
}

model InventorySnapshot {
  id            Int      @id @default(autoincrement())
  product_id    Int
  product       Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_name  String
  date          String
  opening_stock Float?
  closing_stock Float
  units_out     Float    @default(0)
  stock_change  Float?
  movement_type String
  source        String?
  batch_id      Int?
  notes         String?
  updated_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([product_id, date])
  @@index([date])
  @@map("inventory_snapshots")
}

model InventoryMovementLog {
  id            Int      @id @default(autoincrement())
  product_id    Int
  product       Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_name  String
  date          String
  previous_qty  Float?
  new_qty       Float?
  diff          Float?
  movement_type String
  notes         String?
  updated_by    String?
  batch_id      Int?
  created_at    DateTime @default(now())

  @@index([date])
  @@index([product_id])
  @@map("inventory_movement_log")
}

model InventoryColumnMapping {
  id          String   @id @default("default")
  productName String?
  quantity    String?
  sku         String?
  warehouse   String?
  updated_at  DateTime @updatedAt

  @@map("inventory_column_mapping")
}

model InventoryNameMapping {
  id                  Int      @id @default(autoincrement())
  excel_name_key      String   @unique
  excel_name_original String
  product_id          Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("inventory_name_mapping")
}

model InventoryImportBatch {
  id              Int      @id @default(autoincrement())
  date            String
  filename        String?
  uploaded_by     String?
  total_rows      Int?
  matched_count   Int?
  unmatched_count Int?
  duplicate_count Int?
  invalid_count   Int?
  unmatched       String?
  uploaded_at     DateTime @default(now())

  @@index([date])
  @@map("inventory_import_batches")
}

// ============================================================================
// AI Business Intelligence — Phase 1 (Ads Data Upload → Column Mapping →
// Normalized Storage → True Business Performance). See conversation for the
// full 43-section spec this is Phase 1 of; later phases (Decision Center,
// Creative/Audience/Governorate/Moderator Intelligence, Forecasting, AI
// Chat...) are explicitly deferred and add their own models when built.
// ============================================================================

// One row per uploaded Meta Ads Manager export. Raw data is kept verbatim in
// AdsRawRow regardless of what happens after — "احتفظ دائمًا بالـ Raw
// Uploaded Data بدون تعديل" (spec section 1, Step 3).
model AdsUpload {
  id             Int       @id @default(autoincrement())
  filename       String
  file_type      String // csv | xlsx
  status         String    @default("UPLOADED") // UPLOADED | MAPPED | PROCESSED | FAILED
  row_count      Int?
  uploaded_by_id Int?
  uploaded_by    User?     @relation(fields: [uploaded_by_id], references: [id], onDelete: SetNull)
  column_mapping String? // JSON-as-String — confirmed source-column -> canonical-field map (same convention as Settings.data)
  errors         String? // JSON-as-String — validation warnings/errors from Step 1, kept for audit even after processing
  uploaded_at    DateTime  @default(now())
  processed_at   DateTime?

  rawRows AdsRawRow[]
  metrics AdsDailyMetric[]

  @@map("ads_uploads")
}

model AdsRawRow {
  id         Int       @id @default(autoincrement())
  upload_id  Int
  upload     AdsUpload @relation(fields: [upload_id], references: [id], onDelete: Cascade)
  row_index  Int
  raw_data   String // JSON-as-String — the untouched original row exactly as uploaded
  created_at DateTime  @default(now())

  @@index([upload_id])
  @@map("ads_raw_rows")
}

// Normalized, mapped ads performance data — one row per (date, campaign/adset/ad)
// combination as present in the source file. matched_product_* is populated by
// a confidence-gated Campaign Name -> Product match (never a low-confidence
// auto-guess — see services/adsImport.js), the join key True Business
// Performance needs to compare Meta's numbers against real order data.
model AdsDailyMetric {
  id                 Int       @id @default(autoincrement())
  upload_id          Int
  upload             AdsUpload @relation(fields: [upload_id], references: [id], onDelete: Cascade)
  date               String
  campaign_id        String?
  campaign_name      String?
  adset_id           String?
  adset_name         String?
  ad_id              String?
  ad_name            String?
  creative_id        String?
  creative_name      String?
  spend              Float?
  impressions        Int?
  reach              Int?
  frequency          Float?
  clicks             Int?
  ctr                Float?
  cpc                Float?
  cpm                Float?
  landing_page_views Int?
  leads              Int?
  add_to_cart        Int?
  initiate_checkout  Int?
  meta_purchases     Int?
  meta_revenue       Float?
  meta_roas          Float?
  // Meta's own objective-agnostic outcome metric — always present in a
  // standard export regardless of what the campaign optimizes for, unlike
  // meta_purchases (only meaningful for purchase-objective campaigns).
  // result_indicator carries what "Results" actually counted for that row
  // (e.g. "actions:offsite_conversion.fb_pixel_purchase") so it's never a
  // black box. campaign_delivery ("active"/"paused") lets analysis exclude
  // paused campaigns from "why is this still spending" alerts.
  results            Int?
  cost_per_result    Float?
  result_indicator   String?
  campaign_delivery  String?
  matched_product_id Int?
  matched_product    Product?  @relation(fields: [matched_product_id], references: [id], onDelete: SetNull)
  match_confidence   Float?
  match_method       String? // exact_name | exact_sku | fuzzy | unmatched
  created_at         DateTime  @default(now())

  @@index([date])
  @@index([campaign_name])
  @@index([matched_product_id])
  @@map("ads_daily_metrics")
}

// User "Mark as Reviewed" / "Dismiss" on a decision-engine recommendation
// (AI Intelligence Phase 2, spec §21) — the app only ever records that a
// human looked at a recommendation; it never touches Meta budgets/campaigns
// itself. entity_key is a product id (as a string) or a campaign name,
// matching decisionEngine.js's entityKey.
model AdsDecisionReview {
  id             Int      @id @default(autoincrement())
  entity_type    String // product | campaign
  entity_key     String
  status         String // REVIEWED | DISMISSED
  reviewed_by_id Int?
  reviewed_by    User?    @relation(fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at    DateTime @default(now())

  @@unique([entity_type, entity_key])
  @@map("ads_decision_reviews")
}

// Cached AI Action Plan (AI Intelligence Phase 2, spec §9) — the Claude
// Marketing Performance Decision Agent is given the already-computed,
// classified, prioritized entity list from decisionEngine.js (never raw
// CSV rows) and asked only to write the natural-language reason/action text
// plus a short cross-category summary. input_hash lets a page load reuse
// the cached plan instead of calling the API again when nothing changed;
// the "🔄 تحديث الخطة" button forces a fresh call.
model AdsActionPlan {
  id           Int      @id @default(autoincrement())
  window_from  String
  window_to    String
  input_hash   String
  plan_json    String // JSON-as-String — {summary, items: [{entityType, entityKey, reason, recommendedAction}, ...]}
  source       String   @default("AI") // AI | FALLBACK — FALLBACK means the Claude call failed and deterministic templates were used instead
  generated_at DateTime @default(now())

  @@unique([window_from, window_to])
  @@map("ads_action_plans")
}

// Real Meta Ads OAuth connection (Facebook Login for Business) — a
// single-tenant singleton, same idiom as `Settings` (id:"default"). The
// access token is NEVER stored in plaintext (see services/metaCrypto.js)
// and is never sent to the frontend by any route — only `status` and the
// selected-account metadata are. Historical AdsDailyMetric rows synced
// while connected are never deleted on disconnect.
model MetaConnection {
  id                       String    @id @default("default")
  status                   String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED
  connected_by_id          Int?
  connected_by             User?     @relation(fields: [connected_by_id], references: [id], onDelete: SetNull)
  access_token_enc         String? // AES-256-GCM ciphertext, base64 — see metaCrypto.js
  token_expires_at         DateTime?
  meta_user_id             String?
  meta_user_name           String?
  selected_business_id     String?
  selected_business_name   String?
  selected_ad_account_id   String?
  selected_ad_account_name String?
  last_synced_at           DateTime?
  connected_at             DateTime?
  disconnected_at          DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  @@map("meta_connections")
}

// AI E-Commerce Operating System — every real tool call the AI agent makes
// (backend/src/services/aiTools.js) is logged here, and every assistant
// turn (backend/src/routes/aiAssistant.js) is logged as its own entry with
// tool_calls listing the JSON-encoded tool names/results actually used to
// answer it. This is the real Audit Log the spec requires — never a UI
// mockup. Phase 1 ships read-only tools only (action="READ"); write-tool
// entries (action="EXECUTE") are additive groundwork for later phases and
// unused until those tools exist.
model AiAuditLog {
  id          Int      @id @default(autoincrement())
  actor_id    Int? // the logged-in user who triggered this (chat message or quick action) — null for a system-triggered call, none exist yet
  actor       User?    @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  kind        String // "TOOL_CALL" | "ASSISTANT_TURN"
  action      String // "READ" | "EXECUTE" — every Phase 1 tool is READ
  tool_name   String? // set for kind=TOOL_CALL
  input_json  String? // JSON-encoded tool input / user message
  output_json String? // JSON-encoded tool result (never the raw LLM prose for TOOL_CALL rows)
  success     Boolean  @default(true)
  error       String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([kind])
  @@map("ai_audit_log")
}

// ============================================================================
// Product Research Intelligence — multi-platform product/competitor discovery.
// Pipeline: user input -> Claude product analysis -> query generation ->
// search providers (services/searchProviders/*) -> normalization -> Claude
// ranking -> dedup -> saved here. All additive, all new tables.
// ============================================================================

model ProductResearchSearch {
  id                   Int       @id @default(autoincrement())
  user_id              Int
  user                 User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product_id           Int? // optional link to an existing Product
  product              Product?  @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name         String
  product_image        String? // stored filename under uploads/product-research/, never the raw client filename
  country              String    @default("EG")
  language             String    @default("AR_EN")
  platforms_json       String // JSON array, e.g. ["instagram","tiktok","facebook","youtube"]
  results_per_platform Int       @default(25)
  status               String    @default("PENDING") // PENDING|ANALYZING|GENERATING_QUERIES|SEARCHING|RANKING|COMPLETED|PARTIAL|FAILED
  platform_status_json String? // {"instagram":"COMPLETE","tiktok":"FAILED",...} — per-platform status for partial-failure UI
  ai_profile_json      String? // Claude's structured product profile (Step 2 schema)
  input_json           String? // the raw user-entered names/keywords, preserved verbatim — Claude output is merged onto this, never overwrites it
  error                String?
  started_at           DateTime?
  completed_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  queries     ProductResearchQuery[]
  results     ProductResearchResult[]
  competitors ProductResearchCompetitor[]
  insight     ProductResearchInsight?

  @@index([user_id])
  @@index([product_id])
  @@index([status])
  @@map("product_research_searches")
}

model ProductResearchQuery {
  id           Int                   @id @default(autoincrement())
  search_id    Int
  search       ProductResearchSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform     String
  query        String
  query_type   String // EXACT_NAME|ALTERNATIVE_NAME|ARABIC_NAME|ENGLISH_NAME|FEATURE|BENEFIT|PROBLEM|GENERIC|VISUAL_DESCRIPTION
  provider     String // which SearchProvider actually ran this
  result_count Int                   @default(0)
  status       String                @default("PENDING") // PENDING|RUNNING|COMPLETE|FAILED
  error        String?
  created_at   DateTime              @default(now())

  @@index([search_id])
  @@map("product_research_queries")
}

model ProductResearchResult {
  id                         Int                   @id @default(autoincrement())
  search_id                  Int
  search                     ProductResearchSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform                   String
  content_type               String                @default("Unknown") // Profile|Page|Post|Reel|Video|Short|Channel|Creator|Unknown
  canonical_url              String
  original_url               String
  title                      String?
  snippet                    String?
  account_name               String?
  account_url                String?
  thumbnail                  String?
  published_at               DateTime?
  metrics_json               String? // {"views":123,"likes":45,...} — only keys actually returned by the provider, never fabricated
  provider                   String
  classification             String? // EXACT_MATCH|VERY_SIMILAR|SIMILAR|RELATED|IRRELEVANT — null until AI ranking runs
  match_score                Int?
  confidence_score           Int?
  ai_reason                  String?
  ignored                    Boolean               @default(false)
  raw_metadata_json          String? // the provider's raw response fields, kept for debugging/re-ranking, never shown raw in the UI
  discovered_by_queries_json String? // which query ids/text found this result
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt

  competitor ProductResearchCompetitor?

  @@unique([search_id, canonical_url])
  @@index([search_id])
  @@index([platform])
  @@index([match_score])
  @@map("product_research_results")
}

model ProductResearchCompetitor {
  id             Int                    @id @default(autoincrement())
  product_id     Int?
  product        Product?               @relation(fields: [product_id], references: [id], onDelete: SetNull)
  search_id      Int?
  search         ProductResearchSearch? @relation(fields: [search_id], references: [id], onDelete: SetNull)
  result_id      Int?                   @unique
  result         ProductResearchResult? @relation(fields: [result_id], references: [id], onDelete: SetNull)
  platform       String
  account_name   String?
  account_url    String
  country        String?
  follower_count Int? // null (never fabricated) when the provider doesn't return it — UI shows "غير متاح"
  notes          String?
  saved_by_id    Int?
  saved_by       User?                  @relation(fields: [saved_by_id], references: [id], onDelete: SetNull)
  first_seen     DateTime               @default(now())
  last_seen      DateTime               @default(now())
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt

  @@index([product_id])
  @@index([search_id])
  @@map("product_research_competitors")
}

// One row per completed search — the Market Insights section (Step 14).
// Kept separate from ProductResearchSearch so it can be regenerated
// independently without touching the search row itself.
model ProductResearchInsight {
  id            Int                   @id @default(autoincrement())
  search_id     Int                   @unique
  search        ProductResearchSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  insights_json String // {observedData:{...}, aiInterpretation:{...}} — kept explicitly separate per Step 14's requirement
  generated_at  DateTime              @default(now())

  @@map("product_research_ai_insights")
}

// ============================================================
// Internal Creative Discovery — EXPERIMENTAL, fully separate tables.
// Deliberately NOT reusing ProductResearchSearch/Query/Result: the ask was
// explicit isolation ("must be isolated so I can test... safely", "do not
// change current database behavior unless strictly required") — a shared
// table would mean any experimental-path bug or query mistake could leak
// into the real Product Research history/results, which the isolation
// requirement was specifically meant to prevent. Shape mirrors
// ProductResearchSearch/Query/Result closely on purpose so the same
// normalize/dedup/query-generation/ranking service functions can be reused
// as-is (see experimentalCreativeDiscovery.js) without needing any change
// to those shared services.
// ============================================================

model ExperimentalCreativeSearch {
  id                     Int       @id @default(autoincrement())
  user_id                Int
  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_mode            String    @default("INTERNAL_EXPERIMENTAL") // the explicit marker requested — never confused with a real ProductResearchSearch row (they're not even in the same table)
  search_mode            String    @default("TEXT") // TEXT | IMAGE_ONLY — IMAGE_ONLY means product_name was empty at submit time and gets filled in from the generated Product Identity Profile once Stage A finishes
  product_name           String // for IMAGE_ONLY this starts as a placeholder and is overwritten once Stage A image analysis produces a real mainProductName — never left as the placeholder in a COMPLETED/PARTIAL row
  product_image          String? // kept as the FIRST reference image for backward compatibility with every existing read path — never removed
  product_images_json    String? // JSON array of 1-4 real uploaded reference image data-URIs (Step: same-exact-product visual matching) — product_image always equals element [0] of this array when present
  country                String    @default("EG")
  language               String    @default("AR_EN")
  platforms_json         String
  mode                   String    @default("quick") // quick|deep
  status                 String    @default("PENDING") // PENDING|ANALYZING|GENERATING_QUERIES|SEARCHING|RANKING|COMPLETED|PARTIAL|FAILED|CANCELLED
  platform_status_json   String?
  platform_progress_json String? // real per-platform 0-100 progress, JSON map {platform: number} — driven entirely by real execution stages in experimentalCreativeDiscovery.js (job created/provider initialized/queries prepared/per-query progress/results collected/normalized/saved/completed), never a frontend timer; persisted here so it survives a page refresh (Step: real Progress system)
  ai_profile_json        String?
  identity_profile_json  String? // the full Product Identity Profile generated from the image (Stage A + any Stage B enrichment) — see productVisionService.js
  identity_provider      String? // LOCAL_VISION | LOCAL_VISION+ANTHROPIC | ANTHROPIC_VISION — diagnostic: which real provider(s) actually produced this profile (Step 24)
  reference_image_hash   String? // sha256 of the uploaded image bytes — cache key alongside model_version
  input_json             String?
  error                  String?
  started_at             DateTime?
  completed_at           DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  queries ExperimentalCreativeQuery[]
  results ExperimentalCreativeResult[]

  @@index([user_id])
  @@index([status])
  @@map("experimental_creative_searches")
}

model ExperimentalCreativeQuery {
  id           Int                        @id @default(autoincrement())
  search_id    Int
  search       ExperimentalCreativeSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform     String
  query        String
  query_type   String
  provider     String // the REAL provider that actually ran this (e.g. serpapi, youtube_data_api, apify_meta_ad_library) — never a fabricated "internal" label; see the report on why
  result_count Int                        @default(0)
  status       String                     @default("PENDING")
  error        String?
  created_at   DateTime                   @default(now())

  @@index([search_id])
  @@map("experimental_creative_queries")
}

model ExperimentalCreativeResult {
  id                         Int                        @id @default(autoincrement())
  search_id                  Int
  search                     ExperimentalCreativeSearch @relation(fields: [search_id], references: [id], onDelete: Cascade)
  platform                   String
  content_type               String                     @default("Unknown")
  canonical_url              String
  original_url               String
  title                      String?
  snippet                    String?
  account_name               String?
  account_url                String?
  thumbnail                  String?
  published_at               DateTime?
  metrics_json               String?
  provider                   String
  classification             String?
  match_score                Int?
  confidence_score           Int?
  ai_reason                  String?
  visual_match_score         Int? // 0-100, the FINAL visual score used for ranking — local embedding/perceptual-hash/OCR comparison, optionally blended with a real Claude-vision semantic score when Anthropic is healthy. Null when not computed (no reference image, no candidate thumbnail, candidate fetch failed, or beyond the per-search comparison cap) — never guessed.
  local_visual_match_score   Int? // 0-100, the raw LOCAL_VISION-only score (embedding cosine similarity + perceptual hash + OCR brand/model match) — always populated whenever local comparison genuinely ran, independent of Anthropic (Step 10/11)
  visual_match_provider      String? // LOCAL_EMBEDDING | LOCAL_EMBEDDING+ANTHROPIC — diagnostic (Step 24)
  final_score                Int? // the weighted combination (80% visual / 15% text / 5% distinctive attributes) used for image-mode ranking when a reference image exists — null otherwise, text match_score is used as-is
  matched_reference_index    Int? // which uploaded reference image (0-based, into product_images_json) produced the BEST visual match for this result — real multi-reference matching (Step: same-exact-product visual matching), null when no reference image or comparison never ran
  match_reasons              String? // JSON array of short, honest strings describing WHY this score was reached (e.g. "تشابه بصري عالي (embedding)", "تطابق لون مميز", "تطابق نص/موديل OCR") — never invented, only set when a real signal actually contributed
  exact_match_score          Int? // 0-100 (Step: exact product matching) — deterministic weighted combination of visual embedding + structural (perceptual hash) + brand/model text + existing text match_score + color, computed only when a real visual comparison ran; never invented, category alone can never reach a high value here
  match_decision             String? // EXACT | REVIEW | REJECT | null (null = never evaluated, e.g. no reference image) — thresholds are configurable via Settings (icdExactMatchThreshold/icdReviewMatchThreshold), never hardcoded blindly
  ignored                    Boolean                    @default(false)
  raw_metadata_json          String?
  discovered_by_queries_json String?
  ad_analysis_json           String? // Step: Meta Ads competitor intelligence — structured per-ad analysis (hook/angle/price/offer/CTA/etc.), only ever populated for platform=META_AD_LIBRARY rows with match_decision=EXACT. Every field inside carries its own source: OBSERVED|AI_INFERRED|AI_ANALYZED tag — never presented as one undifferentiated fact.
  ad_analysis_status         String? // PENDING | DONE | FAILED | SKIPPED — null until competitor-analysis is attempted for this row
  ad_analyzed_at             DateTime?
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @updatedAt

  @@unique([search_id, canonical_url])
  @@index([search_id])
  @@index([platform])
  @@map("experimental_creative_results")
}

// Step: Meta Ads competitor intelligence — caches one ad's AI analysis by a
// STABLE ad identifier (metrics.adId when available, else a hash of
// canonical_url), never by search_id, so the exact same competitor ad
// surfacing again in a different search is never re-billed to Claude.
// Mirrors ExperimentalImageIdentityCache's exact (key, model_version)
// caching idiom used elsewhere in this file.
model ExperimentalAdAnalysisCache {
  id            Int      @id @default(autoincrement())
  ad_key        String // sha256 of metrics.adId || canonical_url
  model_version String // bumped whenever the analysis prompt/output shape changes, invalidating stale cached entries safely
  analysis_json String
  created_at    DateTime @default(now())

  @@unique([ad_key, model_version])
  @@map("experimental_ad_analysis_cache")
}

// Caches a generated Product Identity Profile by (reference image content
// hash, model version) so re-opening/re-running a search with the exact
// same uploaded image never re-spends a Claude vision call (Steps 26/27).
// Deliberately keyed on the image bytes' hash, not a search id, so it's
// shared across searches/users that happen to upload the identical file.
model ExperimentalImageIdentityCache {
  id            Int      @id @default(autoincrement())
  image_hash    String // sha256 of the raw image bytes
  model_version String // bumped whenever a provider's output shape changes, so an old cached profile is never served against a newer expected shape
  provider      String   @default("ANTHROPIC_VISION") // LOCAL_VISION | ANTHROPIC_VISION — the two providers cache independently under the same image_hash, since LOCAL_VISION is now always attempted and ANTHROPIC_VISION only sometimes
  profile_json  String // LOCAL_VISION: {ocr, embedding, perceptualHash, colors, category, ...}. ANTHROPIC_VISION: the full Claude-generated Product Identity Profile (unchanged shape)
  created_at    DateTime @default(now())

  @@unique([image_hash, model_version, provider])
  @@map("experimental_image_identity_cache")
}

// ============================================================================
// AI MEDIA BUYER — a new decision-making center inside "🧠 AI Intelligence".
// Every table here is ADDITIVE. Nothing above is altered. The existing AI
// Intelligence pipeline (AdsUpload / AdsDailyMetric / AdsActionPlan /
// AdsDecisionReview / decisionEngine.js / campaignAnalysis.js) keeps working
// untouched. AI Media Buyer keeps its OWN immutable performance history in
// meta_performance_snapshots (append-only — never delete/replace, unlike the
// existing metaSync.runSync which does delete-and-replace on AdsDailyMetric).
//
// Mandatory architecture (enforced in services, mirrored by these tables):
//   Meta API → snapshot → deterministic Metrics Engine → Product Economics →
//   deterministic Rule Engine → Claude (interpretation/text ONLY, never math)
//   → structured AmbRecommendation → backend validation → owner approval →
//   revalidation → Meta write → AmbAction (audit) → AmbActionResult (6/12/24h).
// Claude can never bypass backend validation / owner approval / safety rules
// while Approval Mode is on (the default). AI Media Buyer settings live in the
// existing `settings` JSON blob (keys prefixed `amb…`), not a table here —
// same "new field needs no migration" convention as the rest of that row.
// ============================================================================

// One economics profile per advertised product. Optionally linked to an
// existing Product row (to seed cost/price) but keeps its OWN fields because
// the COD media-buying math needs multiplier / confirmation-rate /
// delivery-rate / target-warning-max CPA / target-min profit that `products`
// does not carry — and linking is optional so a product that only exists in
// Meta (not yet in the catalog) can still be modelled.
model AmbProduct {
  id                      Int      @id @default(autoincrement())
  product_id              Int?     @unique
  product                 Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  product_name            String
  external_product_ref    String? // free-text "Product ID" from the merchant's own catalog/CRM when there's no Product row
  // Economics — all deterministic backend inputs. Claude never writes these.
  product_cost            Float    @default(0) // wholesale / COGS per unit
  pricing_multiplier      Float    @default(3) // configurable PER product — never a global hardcode
  suggested_selling_price Float    @default(0) // = product_cost * pricing_multiplier, recomputed on write
  actual_selling_price    Float? // manual override; when set it wins over suggested for every downstream calc
  packaging_cost          Float    @default(0)
  shipping_cost           Float    @default(0)
  other_cost              Float    @default(0)
  rto_cost                Float    @default(0) // return / RTO cost per returned order
  confirmation_rate       Float? // 0..1 — share of Meta purchases that become confirmed orders (from CRM when available)
  delivery_rate           Float? // 0..1 — share of confirmed orders that get delivered
  target_cpa              Float?
  warning_cpa             Float?
  max_cpa                 Float? // maximum allowed CPA — hard ceiling for the rule engine
  target_profit           Float?
  min_profit              Float?
  currency                String   @default("EGP")
  // Optional direct image URL for the product, shown on the recommendation
  // cards. Also the cache slot for a resolver: if a product-page URL is ever
  // added to the data model, a fetch-once og:image lookup would write here.
  image_url               String?
  active                  Boolean  @default(true)
  created_by_id           Int?
  created_by              User?    @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  campaign_maps        AmbProductCampaignMap[]
  recommendations      AmbRecommendation[]
  media_library_assets MediaLibraryAsset[]
  cf_product           CfProduct? // AI Creative Factory profile linked to this AMB product (optional 1:1) — additive

  @@index([active])
  @@map("amb_products")
}

// Links a real Meta campaign to an AmbProduct. status SUGGESTED means an
// AI-assisted guess awaiting human confirmation (never auto-applied to a
// wrong product); MAPPED means a human confirmed it or entered it manually.
// A campaign with no row here is "Unmapped" (surfaced, never blocking).
model AmbProductCampaignMap {
  id               Int        @id @default(autoincrement())
  amb_product_id   Int
  amb_product      AmbProduct @relation(fields: [amb_product_id], references: [id], onDelete: Cascade)
  ad_account_id    String
  campaign_id      String
  campaign_name    String?
  status           String     @default("MAPPED") // MAPPED | SUGGESTED
  match_source     String     @default("MANUAL") // MANUAL | AI_SUGGESTED
  match_confidence Float?
  ai_reason        String?
  created_by_id    Int?
  created_by       User?      @relation(fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  @@unique([ad_account_id, campaign_id])
  @@index([amb_product_id])
  @@map("amb_product_campaign_map")
}

// One backend sync cycle (scheduled every 15 min, or manual). Records what
// actually happened so the UI can show Last/Next/Status honestly.
model AmbSyncRun {
  id                 Int       @id @default(autoincrement())
  trigger            String    @default("SCHEDULED") // SCHEDULED | MANUAL
  status             String    @default("RUNNING") // RUNNING | SUCCESS | PARTIAL | FAILED
  ad_account_id      String?
  account_currency   String?
  started_at         DateTime  @default(now())
  finished_at        DateTime?
  snapshot_rows      Int       @default(0)
  adsdaily_refreshed Int       @default(0) // rows written into the EXISTING AdsDailyMetric by the piggy-backed runSync
  error              String?
  created_at         DateTime  @default(now())

  snapshots MetaPerformanceSnapshot[]

  @@index([started_at])
  @@map("amb_sync_runs")
}

// Append-only. One row per (sync cycle, level, entity, insights-day). NEVER
// updated or deleted — this is the historical trend store the whole module
// analyses over. Budgets are stored in MAJOR account-currency units (EGP),
// already divided from Meta's minor-unit API values.
model MetaPerformanceSnapshot {
  id            Int        @id @default(autoincrement())
  sync_run_id   Int
  sync_run      AmbSyncRun @relation(fields: [sync_run_id], references: [id], onDelete: Cascade)
  snapshot_at   DateTime   @default(now())
  ad_account_id String
  level         String // campaign | adset | ad
  date_start    String // the insights day this row covers (YYYY-MM-DD)
  date_stop     String

  campaign_id          String?
  campaign_name        String?
  campaign_status      String? // effective_status from Meta
  campaign_objective   String?
  campaign_budget      Float? // CBO daily/lifetime budget in EGP, null for ABO campaigns
  campaign_budget_type String? // DAILY | LIFETIME | null
  adset_id             String?
  adset_name           String?
  adset_status         String?
  adset_budget         Float?
  adset_budget_type    String?
  ad_id                String?
  ad_name              String?
  ad_status            String?
  creative_id          String?

  spend             Float?
  impressions       Int?
  reach             Int?
  frequency         Float?
  clicks            Int?
  ctr               Float?
  cpc               Float?
  cpm               Float?
  meta_purchases    Int?
  meta_revenue      Float?
  cost_per_purchase Float?
  conversion_rate   Float? // purchases / clicks * 100
  roas              Float?
  results           Int?
  result_indicator  String?
  actions_json      String? // raw Meta actions array (JSON) — kept for later re-derivation, never shown raw

  created_at DateTime @default(now())

  @@index([snapshot_at])
  @@index([ad_account_id, snapshot_at])
  @@index([level, campaign_id])
  @@index([adset_id])
  @@index([ad_id])
  @@map("meta_performance_snapshots")
}

// A structured recommendation. Numbers/classification/priority/confidence/
// risk/data-sufficiency are all deterministic (Metrics + Economics + Rule
// engines). `reason` is the ONLY field Claude authors; source=FALLBACK means
// the Claude call failed and a deterministic template was used instead.
model AmbRecommendation {
  id             Int         @id @default(autoincrement())
  batch_id       String // groups every recommendation from one analysis run
  ad_account_id  String
  amb_product_id Int?
  amb_product    AmbProduct? @relation(fields: [amb_product_id], references: [id], onDelete: SetNull)
  product_name   String?

  level         String // product | campaign | adset | ad
  entity_id     String? // Meta id of the entity the action targets (campaign/adset/ad id); null for level=product
  entity_name   String?
  campaign_id   String?
  campaign_name String?
  adset_id      String?
  adset_name    String?
  ad_id         String?
  ad_name       String?

  decision    String // SCALE|HOLD|MONITOR|PAUSE|REDUCE_BUDGET|INCREASE_BUDGET|DUPLICATE_WINNER|PAUSE_LOSER|TEST_NEW_CREATIVE|TEST_NEW_HOOK|TEST_NEW_AUDIENCE
  action_type String // PAUSE|RESUME|INCREASE_BUDGET|DECREASE_BUDGET  → executable; anything else stored as DRAFT_* and never auto-executed
  executable  Boolean @default(false) // action_type in the execution whitelist AND rule engine passed

  current_metrics_json String?
  target_metrics_json  String?
  current_budget       Float?
  recommended_budget   Float?
  budget_change_pct    Float?

  reason            String? // Claude-authored (or deterministic fallback)
  reason_facts_json String? // the deterministic facts the reason must be grounded in
  rule_engine_json  String? // {passed: bool, checks: [{name, ok, detail}], blockers: [...]}

  confidence       String @default("LOW") // HIGH | MEDIUM | LOW
  risk_level       String @default("MEDIUM") // LOW | MEDIUM | HIGH
  data_sufficiency String @default("WEAK") // STRONG | MODERATE | WEAK
  priority         String @default("P3") // P0 | P1 | P2 | P3

  time_window_from  String?
  time_window_to    String?
  time_window_label String?
  source            String  @default("AI") // AI | FALLBACK

  // PENDING | APPROVED | EXECUTED | REJECTED | SUPERSEDED | NEEDS_REANALYSIS
  // | RESOLVED_EXTERNALLY (the entity reached the recommended state in Meta
  //   Ads Manager on its own — e.g. an owner paused it manually) | NO_LONGER_APPLICABLE
  //   (the target entity no longer exists / has no recent data). The last
  //   two are set by the post-sync reconciler and drop the rec from the
  //   active Action Plan while keeping it for audit.
  status          String    @default("PENDING")
  reviewed_by_id  Int?
  reviewed_by     User?     @relation(fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at     DateTime?
  resolution_note String? // human-readable reason a rec was auto-resolved (shown in history/details)
  resolved_at     DateTime? // when the reconciler resolved it externally / marked it not applicable
  edited_json     String? // owner "Edit Action" overrides applied before execution

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  actions AmbAction[]

  @@index([status])
  @@index([batch_id])
  @@index([ad_account_id, created_at])
  @@index([priority])
  @@map("amb_recommendations")
}

// One real execution attempt against Meta (post-approval, or by autopilot).
// Full audit row: exactly what was sent, exactly what Meta returned/errored.
model AmbAction {
  id                Int               @id @default(autoincrement())
  recommendation_id Int
  recommendation    AmbRecommendation @relation(fields: [recommendation_id], references: [id], onDelete: Cascade)
  mode              String // ADVISORY | APPROVAL | AUTOPILOT — the mode in effect when this ran
  action_type       String // PAUSE | RESUME | INCREASE_BUDGET | DECREASE_BUDGET
  ad_account_id     String
  level             String
  entity_id         String
  entity_name       String?
  campaign_id       String?
  adset_id          String?
  ad_id             String?

  old_value_json      String? // {status} or {budget, budgetType}
  new_value_json      String?
  ai_reason           String?
  ai_confidence       String?
  metrics_before_json String?

  approval_status    String  @default("APPROVED") // APPROVED (Approval mode) | AUTO (Autopilot)
  execution_status   String  @default("PENDING") // PENDING | REVALIDATING | EXECUTED | FAILED | ABORTED_REANALYSIS
  revalidation_json  String? // {ok, reason, metricDrift:{...}} from the pre-execute recheck
  meta_request_json  String?
  meta_response_json String?
  meta_error         String?

  executed_by_id Int?
  executed_by    User?     @relation(fields: [executed_by_id], references: [id], onDelete: SetNull)
  created_at     DateTime  @default(now())
  executed_at    DateTime?

  results AmbActionResult[]

  @@index([execution_status])
  @@index([recommendation_id])
  @@index([created_at])
  @@map("amb_actions")
}

// Outcome evaluation checkpoints for an executed action (6h / 12h / 24h).
// A background job fills each in when its due_at passes, comparing a
// before-snapshot window against an after-snapshot window (all from
// meta_performance_snapshots — deterministic, never a Claude guess).
model AmbActionResult {
  id           Int       @id @default(autoincrement())
  action_id    Int
  action       AmbAction @relation(fields: [action_id], references: [id], onDelete: Cascade)
  checkpoint   String // H6 | H12 | H24
  due_at       DateTime
  evaluated_at DateTime?

  cpa_before           Float?
  cpa_after            Float?
  roas_before          Float?
  roas_after           Float?
  spend_before         Float?
  spend_after          Float?
  purchases_before     Int?
  purchases_after      Int?
  delivered_cpa_before Float?
  delivered_cpa_after  Float?
  profit_before        Float?
  profit_after         Float?

  result_class String? // SUCCESSFUL | NEUTRAL | FAILED — null until evaluated
  notes_json   String?
  created_at   DateTime @default(now())

  @@unique([action_id, checkpoint])
  @@index([due_at])
  @@map("amb_action_results")
}

// AI Suggested Decisions — "Winner → Scale" lifecycle ONLY. Winner cards are
// computed live from the existing metrics pipeline; this row exists solely so
// a winner the owner Rejected or already Executed is not re-surfaced as a
// fresh pending recommendation. Execution reuses the clone engine
// (AmbCloneBatch) — clone_batch_id links to it.
model AmbScaleDecision {
  id                   Int     @id @default(autoincrement())
  ad_account_id        String
  source_campaign_id   String
  source_campaign_name String?
  product_name         String?
  window_label         String?

  status String @default("PENDING") // PENDING | APPROVED | EXECUTED | REJECTED | FAILED

  orders Int?
  cpa    Float?
  spend  Float?

  winner_ads_json String? // snapshot of the per-ad winner panel at approval time
  budget_mode     String? // CBO | ABO — the owner's explicit choice (never guessed)
  budget_egp      Float? // CBO: the campaign daily budget the owner entered
  plan_json       String? // ABO: [{ sourceAdSetId, dailyBudgetEgp, selectedAdIds:[...] }] as approved
  exec_mode       String? // RUN_NOW | SCHEDULE
  start_at_cairo  String? // "YYYY-MM-DDTHH:MM" (Africa/Cairo) when SCHEDULE
  clone_batch_id  String?

  reviewed_by_id Int?
  reviewed_by    User?     @relation(fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at    DateTime?
  error          String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([ad_account_id, source_campaign_id])
  @@index([status])
  @@map("amb_scale_decisions")
}

// In-app notifications for AI Media Buyer.
model AmbAlert {
  id                Int      @id @default(autoincrement())
  severity          String // CRITICAL | OPPORTUNITY | WARNING | INFO
  category          String // CPA_LIMIT | SCALE_READY | CREATIVE_FATIGUE | WASTED_SPEND | SYNC | EXECUTION | GENERIC
  title             String
  message           String
  ad_account_id     String?
  level             String?
  entity_id         String?
  entity_name       String?
  campaign_id       String?
  recommendation_id Int?
  dedupe_key        String?  @unique // stops the same live condition spamming a new alert every cycle
  read              Boolean  @default(false)
  created_at        DateTime @default(now())

  @@index([read, created_at])
  @@map("amb_alerts")
}

// Per-creative semantic analysis for AI Media Buyer's Winners / creative
// intelligence. Populated by services/amb/creativeAnalysis.js, which
// fetches the REAL creative (body/title/CTA/object_story_spec) from the
// Graph API and does deterministic-first extraction + a single text-only
// Claude call for the fields that need judgment — the same
// deterministic-first, source-tagged approach as the existing
// services/adAnalysis.js (competitor ads), reused here for OWN creatives.
// status: ANALYZED (real labels) | INSUFFICIENT_DATA (creative has no usable
// text) | NOT_ANALYZED (not attempted yet) | FAILED. Labels are NEVER
// invented — a field is null when nothing in the creative supports it.
// Cached by (creative_id, model_version); model_version bumps invalidate.
model AmbCreativeAnalysis {
  id              Int       @id @default(autoincrement())
  ad_account_id   String
  creative_id     String
  model_version   String    @default("amb-creative-v1")
  status          String    @default("NOT_ANALYZED")
  source          String? // DETERMINISTIC | RULE_BASED | AI_ANALYZED | MIXED
  hook            String?
  hook_types_json String? // JSON array from the shared HOOK_TYPES vocab
  selling_angle   String?
  problem         String?
  main_benefit    String?
  product_feature String?
  audience        String?
  offer           String?
  cta             String?
  creative_type   String?
  raw_text        String? // the creative text actually analyzed (audit / never re-derive)
  fields_json     String? // full structured object with a per-field source tag
  analyzed_at     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@unique([creative_id, model_version])
  @@index([ad_account_id])
  @@map("amb_creative_analysis")
}

// ============================================================================
// AI Media Buyer — CAMPAIGN CLONE & SCHEDULE. Every table here is ADDITIVE.
// Copies user-selected campaigns from ONE source ad account into one or more
// destination ad accounts (exact-as-possible: campaign -> ad sets -> ads ->
// creatives, re-uploading account-scoped image/video assets), ALWAYS created
// PAUSED, then a background job flips them ACTIVE at a scheduled time
// (default 00:00 in each destination account's own timezone) — only after an
// explicit owner "APPROVE & SCHEDULE". The source campaigns are NEVER
// modified (this layer only ever GETs from the source and POSTs to the
// destination). Idempotent by batch_id + per-object unique keys, so a
// refresh / retry / worker restart never creates a duplicate; a failed batch
// resumes only the missing / failed objects.
// ============================================================================

model AmbCloneBatch {
  id                           Int       @id @default(autoincrement())
  batch_id                     String    @unique // client-generated UUID — the idempotency key for the whole operation
  source_ad_account_id         String
  source_ad_account_name       String?
  destination_account_ids_json String // JSON string[] — destination act_ ids (the source id can never be in here)
  campaign_ids_json            String // JSON string[] — the source campaign ids the user explicitly picked
  schedule_local_time          String    @default("00:00") // HH:MM, interpreted in each destination account's timezone
  // Optional: post every cloned ad as THIS page in the destination account.
  // Needed when the source creatives carry no page_id (Advantage+ creatives)
  // or are boosted organic posts, and to satisfy a destination account that
  // has its own page. Null ⇒ use whatever page_id the source creative carries.
  destination_page_id          String?
  // The Instagram actor every reconstructed creative posts as in the
  // destination account (a professional IG account the destination Page /
  // Business owns). Null ⇒ Page-identity-only where the format allows it.
  destination_instagram_id     String?
  // Fine-grained overrides (optional). Fall back to destination_page_id /
  // destination_instagram_id when a specific source id has no entry.
  //   { pages: {srcPageId: dstPageId}, instagram: {srcIgId: dstIgId} }
  identity_map_json            String?
  //   { srcPixelId: dstPixelId } — source Pixel/Dataset → a Pixel the
  //   destination account can actually use. Never copy an inaccessible id.
  pixel_map_json               String?
  // Opt-in: recreate a boosted-organic-post ad (object_story_id, no spec) as a
  // fresh ad on the destination identity. Off ⇒ the underlying text/media are
  // still reconstructed when available; only a bare object_story_id with no
  // recoverable content is UNSUPPORTED.
  recreate_boosted             Boolean   @default(false)
  total_copies                 Int       @default(0) // selected campaigns × destination accounts
  // DRAFT | PENDING_APPROVAL | APPROVED | CLONING | SCHEDULED | PARTIALLY_FAILED
  // | COMPLETED | CANCELLED | FAILED
  status                       String    @default("PENDING_APPROVAL")
  preflight_json               String? // JSON — per (campaign,destination) READY/WARNING/BLOCKED + reasons, snapshot at review time
  error                        String?
  approved_by_id               Int?
  approved_by                  User?     @relation("AmbCloneApprover", fields: [approved_by_id], references: [id], onDelete: SetNull)
  approved_at                  DateTime?
  created_by_id                Int?
  created_by                   User?     @relation("AmbCloneCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at                   DateTime  @default(now())
  updated_at                   DateTime  @updatedAt

  jobs   AmbCloneJob[]
  audits AmbCloneAudit[]

  @@index([status])
  @@index([created_at])
  @@map("amb_clone_batches")
}

// One (source campaign -> one destination account) clone unit. This is the
// resumable unit: a batch of 6 campaigns into 2 destinations creates 12 jobs.
model AmbCloneJob {
  id                        Int           @id @default(autoincrement())
  batch_id                  String
  batch                     AmbCloneBatch @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade)
  source_ad_account_id      String
  destination_ad_account_id String
  destination_account_name  String?
  destination_timezone      String? // IANA tz of the destination account, resolved from the Graph API at review time
  source_campaign_id        String
  source_campaign_name      String?
  destination_campaign_id   String? // set once the campaign shell is created in the destination
  destination_page_id       String? // denormalized from the batch for the worker (post cloned ads as this page)
  // PENDING | PREFLIGHT_BLOCKED | CLONING | CLONED_PAUSED | ACTIVATION_PENDING
  // | ACTIVATED | ACTIVATION_FAILED | FAILED | CANCELLED
  status                    String        @default("PENDING")
  preflight_status          String        @default("READY") // READY | WARNING | BLOCKED
  preflight_json            String?
  scheduled_activation_at   DateTime? // UTC instant = schedule_local_time resolved against destination_timezone
  activated_at              DateTime?
  id_map_json               String? // JSON { campaigns:{src:dst}, adsets:{src:dst}, ads:{src:dst}, creatives:{src:dst}, images:{srcHash:dstHash}, videos:{srcId:dstId} }
  copies_created_json       String? // JSON { adsets:n, ads:n, creatives:n }
  error                     String?
  attempts                  Int           @default(0)
  last_attempt_at           DateTime?
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt

  objects   AmbCloneObjectMap[]
  schedules AmbCampaignSchedule[]

  @@unique([batch_id, destination_ad_account_id, source_campaign_id])
  @@index([status])
  @@index([scheduled_activation_at])
  @@map("amb_clone_jobs")
}

// ADVANCED CAMPAIGN SCHEDULING — one row per (copied campaign) scheduling
// window. A copied campaign (an AmbCloneJob that reached CLONED_PAUSED /
// ACTIVATED) can have at most one non-terminal schedule at a time; ended /
// cancelled / failed rows are kept as history.
//
// Times are stored as UTC instants (start_at / end_at). The wall-clock the
// owner entered + the IANA timezone are kept alongside for display and for
// re-deriving on a DST boundary. The server-side scheduler (cloneScheduler.js
// 60s tick) is the ONLY thing that acts on these — never the browser.
//
// The owner's approval of the schedule authorizes BOTH the future start and
// the future end action; the executor still revalidates the live Meta state
// at execution time and refuses (status NEEDS_INTERVENTION) if the copied
// campaign changed, disappeared, or is unsafe to touch.
model AmbCampaignSchedule {
  id                        Int         @id @default(autoincrement())
  clone_job_id              Int
  clone_job                 AmbCloneJob @relation(fields: [clone_job_id], references: [id], onDelete: Cascade)
  batch_id                  String // denormalized for listing without a join
  // Denormalized display context (so a dashboard card needs no extra fetch).
  destination_ad_account_id String
  destination_account_name  String?
  source_account_name       String?
  destination_campaign_id   String?
  campaign_name             String?

  // RUN_NOW | START_AT | START_NO_END | START_AND_END
  mode        String
  timezone    String    @default("Africa/Cairo")
  start_at    DateTime // UTC instant of the scheduled (or immediate) start
  end_at      DateTime? // UTC instant of the scheduled pause; null ⇒ runs until manually stopped
  start_local String? // "YYYY-MM-DD HH:mm" as the owner entered it (display only)
  end_local   String?

  // PENDING_APPROVAL | SCHEDULED | RUNNING | ENDED | PAUSED | CANCELLED
  // | FAILED | NEEDS_INTERVENTION
  // (STARTING_SOON / ENDING_SOON are display-only, derived from the clock.)
  status            String    @default("PENDING_APPROVAL")
  approval_required Boolean   @default(true) // set true again on any material edit; cleared on approve
  created_by_id     Int?
  approved_by_id    Int?
  approved_at       DateTime?
  cancelled_by_id   Int?
  cancelled_at      DateTime?

  actual_start_at          DateTime? // when the scheduler actually activated it
  actual_end_at            DateTime? // when the scheduler (or a manual pause) actually paused it
  start_meta_response_json String?
  end_meta_response_json   String?
  intervention_reason      String? // why status = NEEDS_INTERVENTION
  last_error               String?
  edits_json               String? // append-only JSON array: [{ at, byId, field, from, to }]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([start_at])
  @@index([end_at])
  @@index([clone_job_id])
  @@index([batch_id])
  @@map("amb_campaign_schedules")
}

// Per-object source->destination id mapping. The @@unique key makes every
// create idempotent: on resume/retry the engine finds the CREATED row and
// skips it, so a successful campaign / ad set / ad / creative is never
// recreated. IMAGE / VIDEO rows record the re-uploaded asset in the
// destination account (Meta stores those per ad account).
model AmbCloneObjectMap {
  id               Int         @id @default(autoincrement())
  job_id           Int
  job              AmbCloneJob @relation(fields: [job_id], references: [id], onDelete: Cascade)
  batch_id         String
  level            String // CAMPAIGN | ADSET | AD | CREATIVE | IMAGE | VIDEO
  source_id        String // source object id (IMAGE: source image_hash, VIDEO: source video_id)
  source_name      String?
  parent_source_id String? // adset -> source campaign id, ad -> source adset id, creative -> source ad id
  destination_id   String? // created object id in the destination account — null until status=CREATED
  status           String      @default("PENDING") // PENDING | CREATED | FAILED | SKIPPED
  payload_json     String? // the exact transformed create payload sent to Meta (audit / debugging)
  error            String?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@unique([job_id, level, source_id])
  @@index([job_id])
  @@map("amb_clone_object_map")
}

// Append-only audit of everything that happened to a clone batch: the
// approval, every object created / failed, retries, scheduling, and the
// eventual activation. Never backfilled — one row at the moment it happens.
model AmbCloneAudit {
  id             Int           @id @default(autoincrement())
  batch_id       String
  batch          AmbCloneBatch @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade)
  job_id         Int?
  // APPROVAL | PREFLIGHT | CLONE_START | OBJECT_CREATED | OBJECT_FAILED
  // | JOB_DONE | JOB_FAILED | RETRY | SCHEDULED | ACTIVATION | ACTIVATION_FAILED
  // | CANCELLED
  event          String
  level          String?
  source_id      String?
  destination_id String?
  detail         String?
  data_json      String?
  actor_id       Int?
  actor          User?         @relation("AmbCloneAuditActor", fields: [actor_id], references: [id], onDelete: SetNull)
  created_at     DateTime      @default(now())

  @@index([batch_id])
  @@index([created_at])
  @@map("amb_clone_audit")
}

// ============================================================================
// AI Media Buyer — MEDIA ASSET LIBRARY. One central, deduplicated catalogue of
// every advertising creative used across the connected Meta ad accounts.
// Every table here is ADDITIVE. It does NOT store performance (that stays in
// the append-only meta_performance_snapshots and is aggregated on read by
// creative_id) and it never writes to Meta.
//
//   MediaLibraryAsset      — one row per distinct underlying creative
//                            (content fingerprint), with product link + the
//                            hook/angle labels reused from AmbCreativeAnalysis.
//   MediaLibraryCreativeRef — the cross-account map: one row per
//                            (ad_account_id, Meta creative_id) that resolves to
//                            an asset, plus that account's own image_hash /
//                            video_id for it. This is what lets the cloner
//                            reuse an asset already present in a destination
//                            account instead of re-uploading.
//   MediaLibraryScaling    — "AI found a winning creative → scale it to other
//                            accounts": links an asset to the Clone & Schedule
//                            batch created for it (nothing runs before the
//                            owner's APPROVE & SCHEDULE on that batch).
// ============================================================================

model MediaLibraryAsset {
  id              Int         @id @default(autoincrement())
  // sha1 of a normalized content tuple (page + link + CTA + body + title +
  // sorted image_hashes). Image hashes are content-derived so they're stable
  // across accounts; the same creative re-used or re-uploaded elsewhere lands
  // on the same fingerprint. A creative with no shared content at all gets a
  // per-creative fingerprint instead (never falsely merged).
  fingerprint     String      @unique
  primary_format  String      @default("OTHER") // VIDEO | IMAGE | CAROUSEL | OTHER
  asset_name      String?
  amb_product_id  Int?
  amb_product     AmbProduct? @relation(fields: [amb_product_id], references: [id], onDelete: SetNull)
  link_source     String      @default("NONE") // AUTO_CAMPAIGN_MAP | MANUAL | NONE — MANUAL is sticky, auto never overwrites it
  // Labels mirrored from AmbCreativeAnalysis (kept here so the library is
  // self-contained + correctable); refreshed opportunistically, never invented.
  hook            String?
  hook_types_json String?
  selling_angle   String?
  creative_type   String?
  // A representative sample of the copy + a thumbnail, for the library card.
  sample_body     String?
  sample_title    String?
  sample_cta      String?
  sample_link_url String?
  thumbnail_url   String?
  page_id         String?
  first_seen_at   DateTime    @default(now())
  last_seen_at    DateTime    @default(now())
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  refs     MediaLibraryCreativeRef[]
  scalings MediaLibraryScaling[]

  @@index([amb_product_id])
  @@index([primary_format])
  @@map("media_library_assets")
}

model MediaLibraryCreativeRef {
  id                Int               @id @default(autoincrement())
  asset_id          Int
  asset             MediaLibraryAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  ad_account_id     String
  creative_id       String
  creative_name     String?
  format            String? // VIDEO | IMAGE | CAROUSEL | OTHER (this ref's own format)
  image_hashes_json String? // JSON string[] — this account's image hashes for the creative
  video_ids_json    String? // JSON string[] — this account's video ids for the creative
  origin            String            @default("DISCOVERED") // DISCOVERED (found in a sync) | CLONED (created by Clone & Schedule)
  clone_job_id      Int? // AmbCloneJob.id when origin=CLONED
  first_seen_at     DateTime          @default(now())
  last_seen_at      DateTime          @default(now())
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  @@unique([ad_account_id, creative_id])
  @@index([asset_id])
  @@index([asset_id, ad_account_id])
  @@map("media_library_creative_refs")
}

model MediaLibraryScaling {
  id                           Int               @id @default(autoincrement())
  asset_id                     Int
  asset                        MediaLibraryAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  source_ad_account_id         String
  source_campaign_ids_json     String // JSON string[] — the campaigns running this winning asset that get cloned
  destination_account_ids_json String // JSON string[]
  clone_batch_id               String? // AmbCloneBatch.batch_id — set once the scaling plan becomes a real (unapproved) batch
  status                       String            @default("PLANNED") // PLANNED | BATCH_CREATED | APPROVED | SCHEDULED | COMPLETED | CANCELLED
  reason                       String? // why the AI flagged this asset as a winner (deterministic sentence)
  created_by_id                Int?
  created_by                   User?             @relation("MediaScalingCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at                   DateTime          @default(now())
  updated_at                   DateTime          @updatedAt

  @@index([asset_id])
  @@index([clone_batch_id])
  @@map("media_library_scalings")
}

// ============================================================================
// AI CREATIVE FACTORY — "مصنع الكرياتيفات بالذكاء الاصطناعي".
// A complete, additive system for AI product-image creation: product profile
// + reference photos -> Product DNA -> AI creative plan (owner-approved) ->
// background image generation through a provider abstraction -> automatic
// quality review -> targeted regeneration -> durable storage -> variations
// with lineage -> a performance-learning scaffold linked by a stable
// Creative ID.
//
// Every table here is NEW (cf_ prefix). Nothing in AI Media Buyer, Meta
// sync, Clone & Schedule, Media Library or Champions is modified. The image
// provider (OpenAI) and object storage are pluggable and configured only
// through env vars — the whole workflow runs in a mock-safe "provider off"
// mode with no key present (it never fabricates a generated image).
// ============================================================================

// Creative product profile. An EXTENSION of an existing product where one
// exists (optional 1:1 link to AmbProduct and/or Product) — never a
// replacement — plus the creative-only fields (specs / benefits / claims /
// lock mode). name is kept locally so a project can target something not
// yet in the catalog.
model CfProduct {
  id             Int         @id @default(autoincrement())
  amb_product_id Int?        @unique
  amb_product    AmbProduct? @relation(fields: [amb_product_id], references: [id], onDelete: SetNull)
  product_id     Int?        @unique
  product        Product?    @relation(fields: [product_id], references: [id], onDelete: SetNull)

  name             String
  internal_name    String?
  category         String?
  description      String?
  specifications   String?
  benefits         String?
  use_cases        String?
  target_audience  String?
  problems         String?
  allowed_claims   String?
  forbidden_claims String?
  selling_price    Float?
  currency         String  @default("EGP")
  notes            String?

  // sarem | motawazen | ebdaa  (STRICT is the default — preserve product identity).
  product_lock_mode String @default("STRICT")

  created_by_id Int?
  created_by    User?    @relation("CfProductCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  reference_images CfReferenceImage[]
  dna              CfProductDna?
  projects         CfProject[]
  assets           CfAsset[]

  @@index([amb_product_id])
  @@map("cf_products")
}

// 3-6 product reference photos. Stored through StorageService (provider +
// key); url is a convenience mirror when the provider exposes one.
model CfReferenceImage {
  id         Int       @id @default(autoincrement())
  product_id Int
  product    CfProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  storage_provider String   @default("db")
  storage_key      String
  url              String?
  angle_label      String?
  mime             String   @default("image/jpeg")
  width            Int?
  height           Int?
  bytes            Int?
  sort_order       Int      @default(0)
  active           Boolean  @default(true)
  created_at       DateTime @default(now())

  @@index([product_id])
  @@map("cf_reference_images")
}

// Structured Product DNA (not free text). data_json holds the full
// structured profile (colors, shape, materials, components, logos,
// packaging, "never invent" list, ...). One per product; version bumps on
// re-analysis, reviewed_by_user flips true after a manual correction.
model CfProductDna {
  id         Int       @id @default(autoincrement())
  product_id Int       @unique
  product    CfProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  data_json        String
  confidence       Float?
  version          Int      @default(1)
  reviewed_by_user Boolean  @default(false)
  model_version    String   @default("cf-dna-v1")
  source           String   @default("AI_ANALYZED")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("cf_product_dna")
}

// A creative project = one product + one goal + a quantity + settings.
// project_type: PRODUCT_PAGE | META_ADS | SOCIAL | RETARGETING | VARIATIONS | CUSTOM
// status: DRAFT | PLANNING | PLAN_READY | QUEUED | GENERATING | REVIEWING |
//         REGENERATING | PARTIAL_COMPLETE | COMPLETED | FAILED | CANCELLED
model CfProject {
  id         Int       @id @default(autoincrement())
  product_id Int
  product    CfProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  project_type       String
  quantity           Int     @default(1)
  quantity_mode      String  @default("MANUAL")
  ai_quantity_reason String?
  generation_mode    String  @default("FAST")
  style_preset       String?
  market             String  @default("EG")
  language           String  @default("ar")
  dialect            String  @default("egyptian")
  aspect_ratio       String  @default("1:1")
  text_density       String  @default("MINIMAL")
  people_rule        String  @default("NONE")
  hijab_required     Boolean @default(false)
  product_lock_mode  String  @default("STRICT")
  status             String  @default("DRAFT")
  plan_notes         String?
  estimated_cost     Float?

  created_by_id Int?
  created_by    User?     @relation("CfProjectCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  archived_at   DateTime?

  items CfProjectItem[]
  jobs  CfJob[]

  @@index([product_id])
  @@index([status])
  @@map("cf_projects")
}

// One planned image inside a project (the "Creative Plan" card), plus its
// live generation status. status: PLANNED | QUEUED | GENERATING | REVIEWING |
// REGENERATING | COMPLETED | NEEDS_REVIEW | FAILED
model CfProjectItem {
  id         Int       @id @default(autoincrement())
  project_id Int
  project    CfProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  position                Int
  purpose                 String?
  angle                   String?
  scene                   String?
  product_placement       String?
  camera_angle            String?
  composition             String?
  background              String?
  headline                String?
  supporting_copy         String?
  cta                     String?
  features_json           String?
  reference_priority_json String?
  visual_style            String?
  reason                  String?
  plan_meta_json          String? // { creativeGoal, marketingAngle, customerQuestion, visualConcept, cameraPlan, scenePlan, productPosition, copyGoal, textLayout } — spec §6
  creative_direction_json String?
  continuity_json         String?
  status                  String  @default("PLANNED")
  approved_asset_id       Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  copy     CfCreativeCopy?
  attempts CfGenerationAttempt[]
  assets   CfAsset[]

  @@index([project_id])
  @@index([status])
  @@map("cf_project_items")
}

// Arabic marketing copy — stored SEPARATELY from the technical generation
// prompt (spec requirement). claim_status: PENDING | PASSED | REWRITTEN | BLOCKED
model CfCreativeCopy {
  id              Int           @id @default(autoincrement())
  project_item_id Int           @unique
  project_item    CfProjectItem @relation(fields: [project_item_id], references: [id], onDelete: Cascade)

  hook                  String?
  supporting_line       String?
  feature_callouts_json String?
  cta                   String?
  headline              String?
  subtitle              String?
  alignment             String?
  priority              String?
  safe_area             String?
  claim_status          String   @default("PENDING")
  claim_issues_json     String?
  edited_by_user        Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("cf_creative_copy")
}

// One generation attempt for one project item. status: PENDING | RUNNING |
// SUCCEEDED | FAILED | REJECTED
model CfGenerationAttempt {
  id              Int           @id @default(autoincrement())
  project_item_id Int
  project_item    CfProjectItem @relation(fields: [project_item_id], references: [id], onDelete: Cascade)

  attempt_number         Int      @default(1)
  provider               String   @default("disabled")
  model                  String?
  prompt                 String?
  prompt_version         Int      @default(1)
  corrective_prompt      String?
  provider_request_json  String?
  provider_metadata_json String?
  status                 String   @default("PENDING")
  images_requested       Int      @default(1)
  usage_json             String?
  estimated_cost         Float?
  actual_cost            Float?
  duration_ms            Int?
  error                  String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  assets CfAsset[]

  @@index([project_item_id])
  @@map("cf_generation_attempts")
}

// A stored image. uuid is the STABLE Creative ID that survives regeneration,
// download and Meta linkage. kind: GENERATED | REFERENCE | OVERLAY.
// status: PENDING_REVIEW | APPROVED | REJECTED | ARCHIVED | CANDIDATE
model CfAsset {
  id                    Int                  @id @default(autoincrement())
  uuid                  String               @unique @default(uuid())
  project_item_id       Int?
  project_item          CfProjectItem?       @relation(fields: [project_item_id], references: [id], onDelete: SetNull)
  generation_attempt_id Int?
  generation_attempt    CfGenerationAttempt? @relation(fields: [generation_attempt_id], references: [id], onDelete: SetNull)
  parent_asset_id       Int?
  parent_asset          CfAsset?             @relation("CfAssetLineage", fields: [parent_asset_id], references: [id], onDelete: SetNull)
  product_id            Int?
  product               CfProduct?           @relation(fields: [product_id], references: [id], onDelete: SetNull)

  storage_provider  String  @default("db")
  storage_key       String
  url               String?
  thumbnail_key     String?
  mime              String  @default("image/png")
  width             Int?
  height            Int?
  bytes             Int?
  kind              String  @default("GENERATED")
  status            String  @default("PENDING_REVIEW")
  is_candidate      Boolean @default(false)
  candidate_rank    Int?
  variation_type    String?
  generation_number Int     @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  quality_review       CfQualityReview?
  children             CfAsset[]           @relation("CfAssetLineage")
  variations_as_parent CfVariation[]       @relation("CfVariationParent")
  variations_as_child  CfVariation[]       @relation("CfVariationChild")
  performance_links    CfPerformanceLink[]
  feedback             CfFeedback[]

  @@index([project_item_id])
  @@index([product_id])
  @@index([status])
  @@map("cf_assets")
}

// Generic durable blob store for the `db` storage provider (Postgres bytea)
// — the mock-safe default that needs no external bucket / secret. Used for
// BOTH reference images and generated assets, addressed by a string
// storage_key. Other providers (s3 / cloudinary / supabase) store nothing
// here and resolve storage_key against their bucket instead.
model CfBlob {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  data       Bytes
  mime       String   @default("image/png")
  bytes      Int      @default(0)
  created_at DateTime @default(now())

  @@map("cf_blobs")
}

// Automatic quality evaluation for one asset. Scores 0-100. passed gates
// whether the asset can be APPROVED without human review.
model CfQualityReview {
  id       Int     @id @default(autoincrement())
  asset_id Int     @unique
  asset    CfAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  overall_score               Float?
  product_accuracy_score      Float?
  identity_score              Float?
  visual_quality_score        Float?
  composition_score           Float?
  product_visibility_score    Float?
  marketing_score             Float?
  arabic_text_score           Float?
  text_readability_score      Float?
  claim_score                 Float?
  artifact_score              Float?
  reference_consistency_score Float?
  plan_compliance_score       Float?

  passed               Boolean  @default(false)
  failure_reasons_json String?
  recommendation       String?
  review_output_json   String?
  judge_model          String?
  created_at           DateTime @default(now())

  @@map("cf_quality_reviews")
}

// Background generation job — mirrors the AMB clone job pattern (DB row +
// interval worker) so progress survives a page refresh. status: QUEUED |
// GENERATING | REVIEWING | REGENERATING | PARTIAL_COMPLETE | COMPLETED |
// FAILED | CANCELLED
model CfJob {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  project_id Int
  project    CfProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  kind            String    @default("PROJECT_GENERATION")
  status          String    @default("QUEUED")
  total_items     Int       @default(0)
  completed_items Int       @default(0)
  failed_items    Int       @default(0)
  progress        Int       @default(0)
  item_ids_json   String?
  error           String?
  started_at      DateTime?
  finished_at     DateTime?
  heartbeat_at    DateTime?

  created_by_id Int?
  created_by    User?    @relation("CfJobCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([project_id])
  @@index([status])
  @@map("cf_jobs")
}

// Variation lineage — every variation records its parent, type and
// generation number. variation_type: SAME_CONCEPT | NEW_HOOK | NEW_COPY |
// NEW_BACKGROUND | NEW_CAMERA_ANGLE | NEW_ENVIRONMENT | NEW_AUDIENCE |
// NEW_STYLE | NEW_ANGLE
model CfVariation {
  id              Int      @id @default(autoincrement())
  parent_asset_id Int
  parent_asset    CfAsset  @relation("CfVariationParent", fields: [parent_asset_id], references: [id], onDelete: Cascade)
  child_asset_id  Int?
  child_asset     CfAsset? @relation("CfVariationChild", fields: [child_asset_id], references: [id], onDelete: SetNull)
  project_id      Int?

  variation_type    String
  generation_number Int     @default(1)
  instructions_json String?
  status            String  @default("PENDING")

  created_by_id Int?
  created_by    User?    @relation("CfVariationCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at    DateTime @default(now())

  @@index([parent_asset_id])
  @@map("cf_variations")
}

// Links a stable Creative ID (asset uuid) to a real Meta ad + its imported
// performance. Populated later by the learning layer; nothing here is
// fabricated. One row per (asset, meta ad).
model CfPerformanceLink {
  id         Int      @id @default(autoincrement())
  asset_uuid String
  asset_id   Int?
  asset      CfAsset? @relation(fields: [asset_id], references: [id], onDelete: SetNull)

  ad_account_id    String?
  meta_ad_id       String?
  meta_creative_id String?
  campaign_name    String?
  adset_name       String?
  ad_name          String?
  linked_by        String  @default("MANUAL")

  spend       Float?
  impressions Int?
  clicks      Int?
  ctr         Float?
  cpc         Float?
  purchases   Int?
  cpa         Float?
  cvr         Float?
  roas        Float?
  revenue     Float?
  sample_size Int?

  last_synced_at DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@unique([asset_uuid, meta_ad_id])
  @@index([asset_id])
  @@map("cf_performance_links")
}

// Aggregated learning output (which hooks / angles / styles / concepts
// perform best) with an explicit sample size + confidence — never a
// causation claim from weak data. dimension: HOOK | ANGLE | STYLE | CONCEPT |
// FORMAT
model CfLearningInsight {
  id            Int      @id @default(autoincrement())
  dimension     String
  key           String
  sample_size   Int      @default(0)
  confidence    Float?
  avg_cpa       Float?
  avg_roas      Float?
  avg_ctr       Float?
  win_rate      Float?
  verdict       String?
  evidence_json String?
  computed_at   DateTime @default(now())

  @@unique([dimension, key])
  @@map("cf_learning_insights")
}

// Explicit owner feedback on a generated creative (spec §21). Keyed by
// product category / creative angle / style so Creative Strategy can weight
// future plans. verdict: UP | DOWN. reason: free-form or one of a known set.
model CfFeedback {
  id               Int      @id @default(autoincrement())
  asset_id         Int
  asset            CfAsset  @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  verdict          String // UP | DOWN
  reason           String? // المنتج اتغير | الفكرة ضعيفة | التصميم مش عاجبني | الكلام ضعيف | الصورة مش واقعية | استخدام المنتج غلط | أخرى
  note             String?
  product_category String?
  creative_angle   String?
  style_preset     String?
  prompt_strategy  String? // e.g. lock mode + text layout
  created_by_id    Int?
  created_by       User?    @relation("CfFeedbackCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_at       DateTime @default(now())

  @@index([asset_id])
  @@index([product_category, creative_angle])
  @@map("cf_feedback")
}
